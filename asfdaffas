local QUESTION_KW = {
    "when was","how old","what year","what month","birthday","age of",
    "released","release date","hint","riddle","figure out","guess",
    "first letter","combine","spell","backwards","months","years",
    "old is","how many","what is","do you know","can you","which month",
    "which year","how long","since when","what day","rarest","rarity",
    "common","rare","epic","legendary","mythic","secret","og","brainrot",
    "mutation","update","launch","exist","copies","valuable","oldest",
    "first","when did","who is","what are","how many","tell me",
}

local function isQuestion(txt)
    local l=txt:lower()
    for _,p in ipairs(QUESTION_KW) do if l:find(p,1,true) then return true end end
    if l:find("%?") then return true end
    return false
end

local function solveLocal(txt)
    local l=txt:lower()
    local KB=GAME_KB

    -- Rarity questions
    if l:find("highest rarity") or l:find("rarest rarity") or (l:find("top") and l:find("rarity")) then
        return "The highest rarity is OG."
    end
    if l:find("rarity") and (l:find("order") or l:find("list") or l:find("all")) then
        return "Rarities (low→high): Common, Rare, Epic, Legendary, Mythic, Brainrot God, Secret, OG."
    end

    -- Rarest brainrot
    if (l:find("rarest") or l:find("hardest")) and (l:find("brainrot") or l:find("unit") or l:find("find")) then
        if l:find("exist") or l:find("cop") then
            return "Rarest by exist count: Rico Dinero (1+), Lazy Ducky (4+), Spyder Elephant (25), Arcadragon (~70), John Pork (~80)."
        end
        return "The rarest rarity is OG. Rarest by copies: Rico Dinero (only 1+ exist)."
    end

    -- Most common
    if (l:find("most common") or l:find("easiest")) and l:find("brainrot") then
        return "The most common Brainrot is Noobini Pizzanini with 100 million+ estimated copies."
    end

    -- OG brainrots
    if l:find("og") and (l:find("example") or l:find("which") or l:find("what") or l:find("name")) then
        return "Famous OG Brainrots include: Strawberry Elephant and Spyder Elephant. Strawberry Elephant is considered the most valuable."
    end

    -- Most valuable
    if l:find("most valuable") or (l:find("best") and l:find("og")) then
        return "Strawberry Elephant is considered the most valuable OG Brainrot."
    end

    -- Launch / release date
    if (l:find("launch") or l:find("release") or l:find("start") or l:find("when")) and (l:find("game") or l:find("brainrot") or l:find("steal")) then
        return "Steal a Brainrot launched on May 15-16, 2025."
    end
    if l:find("what year") and (l:find("game") or l:find("brainrot") or l:find("launch")) then
        return "2025"
    end
    if l:find("what month") and (l:find("launch") or l:find("release") or l:find("start")) then
        return "May"
    end

    -- First secrets
    if l:find("first secret") or (l:find("secret") and (l:find("first") or l:find("original") or l:find("og"))) then
        return "The first Secret Brainrots were Los Tralaleritos and La Vacca Saturno Saturnita, added in Update 1 on May 31, 2025."
    end

    -- Update 1
    if l:find("update 1") or (l:find("first update") and l:find("when")) then
        return "Update 1 released May 31, 2025. It added Secret rarity, Gold mutation, and Diamond mutation."
    end

    -- Mutations
    if l:find("mutation") and (l:find("what") or l:find("list") or l:find("all") or l:find("types")) then
        return "Mutations: Gold, Diamond, Bloodmoon, Rainbow."
    end
    if l:find("first mutation") or (l:find("mutation") and l:find("first")) then
        return "The first mutations were Gold and Diamond, added in Update 1 on May 31, 2025."
    end

    -- Day-one / launch brainrots
    if (l:find("launch") or l:find("day.one") or l:find("oldest") or l:find("original")) and l:find("brainrot") then
        return "Day-one/launch Brainrots: Noobini Pizzanini, Tim Cheese, Trippi Troppi, Tung Tung Tung Sahur, Tralalero Tralala."
    end

    -- Specific exist counts
    if l:find("rico dinero") then return "Rico Dinero is extremely rare with only 1+ known copies." end
    if l:find("lazy ducky") then return "Lazy Ducky has only 4+ known copies, making it one of the rarest." end
    if l:find("spyder elephant") then return "Spyder Elephant is an OG Brainrot with only ~25 known copies." end
    if l:find("arcadragon") then return "Arcadragon has approximately 70 known copies." end
    if l:find("john pork") then return "John Pork has approximately 80 known copies." end
    if l:find("strawberry elephant") then return "Strawberry Elephant is an OG Brainrot considered one of the most valuable." end
    if l:find("noobini") then return "Noobini Pizzanini is a day-one launch Brainrot with 100 million+ copies — the most common." end

    -- Lucky blocks / candy / traits
    if l:find("lucky block") then return "Lucky Blocks were introduced in the June-July 2025 update." end
    if l:find("candy event") then return "The Candy event ran during the June-July 2025 update period." end
    if l:find("trait") then return "Traits were introduced in the June-July 2025 update period." end
    if l:find("bloodmoon") then return "Bloodmoon mutation was added in the June-July 2025 update." end
    if l:find("rainbow") and l:find("mutation") then return "Rainbow mutation was added in the June-July 2025 update." end

    -- Legacy SAB (old Steal a Brainrot) code hints
    if (l:find("month") or l:find("when")) and (l:find("sab") or l:find("steal") or l:find("releas")) then
        return "MAY"
    end
