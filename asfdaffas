    if (l:find("age") or l:find("old")) and l:find("sammy") then return "24" end
    if l:find("may") and l:find("24") then return "MAY24" end

    return nil
end

local function callAI(prompt)
    if not ANTHROPIC_KEY or ANTHROPIC_KEY=="" or ANTHROPIC_KEY:find("placeholder") then return nil end
    local ok,result=pcall(function()
        local sysPrompt = [[You are an expert on the Roblox game "Steal a Brainrot" (SAB).
GAME FACTS:
- Launched May 15-16, 2025
- Rarities (low to high): Common, Rare, Epic, Legendary, Mythic, Brainrot God, Secret, OG
- OG is the highest rarity
- First Secrets (Update 1, May 31 2025): Los Tralaleritos, La Vacca Saturno Saturnita
- Rarest by copies: Rico Dinero (1+), Lazy Ducky (4+), Spyder Elephant (25), Arcadragon (~70), John Pork (~80)
- Most common: Noobini Pizzanini (100M+ copies)
- Famous OGs: Strawberry Elephant (most valuable), Spyder Elephant
- Day-one units: Noobini Pizzanini, Tim Cheese, Trippi Troppi, Tung Tung Tung Sahur, Tralalero Tralala
- Mutations: Gold, Diamond (Update 1), Bloodmoon, Rainbow (June-July 2025)
- Traits, Candy event, Lucky Blocks: June-July 2025
Answer ONLY the question asked. Be very short and direct (max 1-2 sentences or just the answer). If it's a code riddle, output ONLY the code uppercase.]]
        local body=HttpService:JSONEncode({
            model="claude-sonnet-4-6",
            max_tokens=60,
            system=sysPrompt,
            messages={{role="user",content=prompt}}
        })
        local resp=HttpService:RequestAsync({
            Url="https://api.anthropic.com/v1/messages",
            Method="POST",
            Headers={
                ["Content-Type"]="application/json",
                ["x-api-key"]=ANTHROPIC_KEY,
                ["anthropic-version"]="2023-06-01",
            },
            Body=body,
        })
        if resp.StatusCode==200 then
            local data=HttpService:JSONDecode(resp.Body)
            if data and data.content and data.content[1] then return data.content[1].text end
        end
        return nil
    end)
    if ok and result then
        local trimmed=tostring(result):match("^%s*(.-)%s*$")
        return trimmed~="" and trimmed or nil
    end
    return nil
end

-- ============================================================
-- HUD NOISE FILTER (FIXED)
-- Catches timers like 52s, 53s, 54s and other HUD garbage
-- ============================================================
local HUD_NOISE_PAT = {
    "^%d+m%s*%d+s$",       -- "15m 18s"
    "^%d+s$",               -- "52s", "53s", "54s"  ← main fix
    "^%d+m$",               -- "3m"
    "^%d+h$",               -- "2h"
    "^%d+h%s*%d+m$",        -- "1h 30m"
    "^%d+:%d+$",            -- "1:30"
    "^%d+:%d+:%d+$",        -- "1:30:00"
    "^%d+x%s*time",         -- "30x time"
    "^%d+x$",               -- "30x"
    "^x%d+$",               -- "x30"
    "^%d+$",                -- pure numbers
    "%$%d",                 -- "$42.5M/s"
    "m%/s",                 -- per-second stat
    "^%d+%.%d+[bBmMkK]",   -- "42.5M"
    "^%+%d+",               -- "+500"
    "^%-%d+",               -- "-10"
    "^%d+%%%s*$",           -- "75%"
}

local HUD_NOISE_WORDS = {
    "time","score","level","wave","stage","round","kills","coins","gems",
    "cash","exp","xp","speed","health","hp","mp","energy","target",
    "current","average","network","people","sent","rebirth","prestige",
    "timer","countdown","elapsed","remaining","seconds","minutes",
}

local function isHudNoise(txt)
    local l = txt:lower():match("^%s*(.-)%s*$")
    if #l == 0 then return true end

    -- Anchored pattern check
    for _, pat in ipairs(HUD_NOISE_PAT) do
        if l:find(pat) then return true end
    end

    -- Short text (≤3 words) with known HUD words
    local wordCount = 0
    for _ in l:gmatch("%S+") do wordCount = wordCount + 1 end
    if wordCount <= 3 then
        for _, nw in ipairs(HUD_NOISE_WORDS) do
            if l:find(nw, 1, true) then return true end
        end
    end

    -- Catch anything that is purely a number + single time/size unit letter
    -- Handles edge cases like "52s" with trailing space, "3M", "10K", etc.
    if l:match("^%d+[smhSMH]%.?$") then return true end
    if l:match("^%d+[kKmMbBgGxX]$") then return true end

    -- "30x time", "15m 18s" combo patterns
    if l:match("%d+x%s+%a") or l:match("%d+m%s*%d+s") then return true end

    return false
end

-- ============================================================
-- CODE EXTRACTOR (FIXED)
-- Now requires at least 3 letters to avoid "52S", "X12" etc.
-- ============================================================
local function extractCode(txt)
    if isHudNoise(txt) then return nil end
    local codes = {}
    for w in txt:gmatch("%S+") do
        local clean = w:gsub("[^A-Za-z0-9_%-]", "")
        if #clean >= 4 then
            local letterCount = #(clean:gsub("[^A-Za-z]", ""))
            -- Must be ALL CAPS and have at least 3 real letters
            -- (raised from 2 — stops "52S", "X12", "30XP" slipping through)
            if clean == clean:upper() and letterCount >= 3 then
                -- Skip tokens that are just a number + 1-2 capital letters (unit abbreviations)
                if not clean:match("^%d+[A-Z]$") and not clean:match("^%d+[A-Z][A-Z]$")
                and not clean:match("^[A-Z]%d+$") and not clean:match("^[A-Z][A-Z]%d+$") then
                    table.insert(codes, clean)
                end
            end
        end
    end
    if #codes > 0 then return table.concat(codes, " ") end
    return nil
end

-- Legacy word extractor kept for fallback
local function extractWords(txt)
    local words={}
    for w in txt:gmatch("%S+") do
        local clean=w:gsub("[^A-Za-z0-9]","")
        if #clean>=2 then
            local isUpper=clean==clean:upper() and clean:match("[A-Z]")
            local isLower=clean==clean:lower() and clean:match("[a-z]") and #clean>=3
            if isUpper or isLower then
                table.insert(words,clean)
            end
        end
    end
    if #words>0 then return table.concat(words," ") end
    return nil
end

-- ============================================================
-- TOP-SCREEN DETECTION
-- Returns true if the GuiObject is positioned in the top 20% of the screen
-- ============================================================
local function isAtTopOfScreen(obj)
    if not obj or not obj:IsA("GuiObject") then return false end
    local ok, pos = pcall(function()
        return obj.AbsolutePosition
    end)
    if not ok then return false end
    local screenHeight = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y or 768
    local objY = pos.Y
    -- Top 20% threshold
    return objY < (screenHeight * TOP_SCREEN_THRESHOLD)
end

-- ============================================================
-- PROCESS GLOBAL TEXT
-- ============================================================
local function processGlobal(txt, fromTopScreen)
    if not _enabled then return end
    if not txt or type(txt)~="string" or #txt<2 then return end
    if not fromTopScreen then return end

    -- Skip HUD noise (timers, multipliers, stat displays)
    if isHudNoise(txt) then return end

    if _seen[txt] then return end
    _seen[txt]=true
    task.delay(20, function() _seen[txt]=nil end)

    -- Always try to grab an inline code even from question text
    local inlineCode = extractCode(txt)
    if inlineCode and not isQuestion(txt) == false then
        -- If there's a standalone all-caps code in the text, flash it
        flashCode(inlineCode, T.Accent)
    end

    if isQuestion(txt) then
        showRiddle("Thinking...", T.Yellow)
        setStatus("Question detected...", T.Yellow)

        -- Try local knowledge first
        local ans = solveLocal(txt)
        if ans then
            showRiddle("Answer: "..ans, T.Green)
            setStatus("Answered!", T.Green)
            flashCode(ans, T.Green)
            appendToBox(ans)
            task.delay(5, hideRiddle)
            return
        end

        -- Fall back to AI
        showRiddle("Asking AI...", T.Yellow)
        task.spawn(function()
            local ai = callAI(txt)
            if ai then
                showRiddle("AI: "..ai, T.Green)
                setStatus("AI answered!", T.Green)
                flashCode(ai, T.Green)
                appendToBox(ai)
                task.delay(5, hideRiddle)
            else
                showRiddle("Could not answer", T.Red)
                setStatus("No answer found", T.Red)
                task.delay(3, function()
                    hideRiddle()
                    setStatus(_focused and "Ready — watching" or "Click the code box first",
                        _focused and T.Green or T.Dim)
                end)
            end
        end)
        return
    end

    -- Not a question: only paste confirmed all-caps promo codes, nothing else
    local code = extractCode(txt)
    if code then
        appendToBox(code)
        flashCode(code, T.Accent)
        setStatus("Code detected!", T.Accent)
    end
end

-- ============================================================
-- BLACKLIST: GUI names that belong to the codes menu / input UI
-- ============================================================
local UI_BLACKLIST = {
    "codebox","codeinput","codeentry","textbox","input","submit",
    "redeem","codes","dlc","codemenu","codesframe","codesui",
}
local function isBlacklistedUI(obj)
    if obj:IsA("TextBox") then return true end
    local name  = (obj.Name or ""):lower()
    local pname = (obj.Parent and obj.Parent.Name or ""):lower()
    local gpname= (obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Name or ""):lower()
    for _, b in ipairs(UI_BLACKLIST) do
        if name:find(b,1,true) or pname:find(b,1,true) or gpname:find(b,1,true) then
            return true
        end
    end
    return false
end

-- ============================================================
-- WATCH LABEL — only if at top of screen and not blacklisted
-- ============================================================
local _watched = {}
local function watchLabel(obj)
    if _watched[obj] then return end
    if isBlacklistedUI(obj) then return end
    _watched[obj] = true
    obj:GetPropertyChangedSignal("Text"):Connect(function()
        if obj == _focused then return end
        if isAtTopOfScreen(obj) and not isBlacklistedUI(obj) then
            processGlobal(obj.Text, true)
        end
    end)
end

-- ============================================================
-- SCAN NEW GUI DESCENDANTS
-- Only register TextLabels that appear at the top of screen
-- ============================================================
playerGui.DescendantAdded:Connect(function(obj)
    task.wait(0.08)
    if obj:IsA("TextBox") then return end
    if not obj:IsA("TextLabel") then return end
    if isBlacklistedUI(obj) then return end
    if not isAtTopOfScreen(obj) then return end

    local txt = obj.Text or ""
    watchLabel(obj)
    if #txt > 1 then
        processGlobal(txt, true)
    end

    obj:GetPropertyChangedSignal("Text"):Connect(function()
        if obj == _focused then return end
        if isAtTopOfScreen(obj) and not isBlacklistedUI(obj) then
            if not _watched[obj] then watchLabel(obj) end
            processGlobal(obj.Text, true)
        end
    end)
end)

