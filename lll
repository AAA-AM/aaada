                    n = n + 1
                    if n > 40 then break end
                    if type(sub) == "table" then consider(sub, depth + 1) end
                end
            end
        end
        if getupvalues then
            local ok, ups = pcall(getupvalues, fn)
            if ok and type(ups) == "table" then
                for _, v in pairs(ups) do consider(v, 0) end
            end
        elseif getupvalue then
