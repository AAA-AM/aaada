        local vcy = cy - h + vy * 0.5
        local parts = workspace:GetPartBoundsInBox(CFrame.new(cx, vcy, cz), Vector3.new(sxz, vy, sxz), _vxOverlap)
        local solid = #parts > 0
        _vxSolid[k] = solid
        return solid
