                    if dist < 30 then
                        col = Color3.fromRGB(255, 196, 72)
                    end
                end
                bestBeam.Color = ColorSequence.new(col)
            end
        end)
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        currentTargetPart = nil
        bestAtt0 = nil
        if bestBeam then pcall(function() bestBeam:Destroy() end); bestBeam = nil end
