                out[#out + 1] = path[i]
                anchor = i
            end
            i += 1
        end
        out[#out + 1] = path[#path]
        return out
    end

    voxelRoute = function(fromPos, toPos)
        local char = player.Character
        local _flt = char and { char } or {}
        for _, cl in ipairs(_OTHER_CLONES) do _flt[#_flt + 1] = cl end
        _vxOverlap.FilterDescendantsInstances = _flt
        _vxCast.FilterDescendantsInstances = _flt

        local sz      = tonumber(_G.VanishPathCell)   or 4
        local inflate = tonumber(_G.VanishPathRadius) or 2.5
        local height  = tonumber(_G.VanishPathHeight) or 5
        local pad     = tonumber(_G.VanishPathPad)    or 40

        _vxSz, _vxInflate, _vxHeight = sz, inflate, height
        table.clear(_vxSolid)

        local mn = Vector3.new(_vxMin(fromPos.X, toPos.X), _vxMin(fromPos.Y, toPos.Y), _vxMin(fromPos.Z, toPos.Z)) - Vector3.new(pad, pad, pad)
        local mx = Vector3.new(_vxMax(fromPos.X, toPos.X), _vxMax(fromPos.Y, toPos.Y), _vxMax(fromPos.Z, toPos.Z)) + Vector3.new(pad, pad, pad)
        _vxOrigin = mn
        local size = mx - mn
        _vxDimX = _vxFloor(size.X / sz) + 1
        _vxDimY = _vxFloor(size.Y / sz) + 1
        _vxDimZ = _vxFloor(size.Z / sz) + 1
        if _vxDimX * _vxDimY * _vxDimZ > 200000 then return nil end

        local startCell = {
            x = _vxFloor((fromPos.X - _vxOrigin.X) / sz),
            y = _vxFloor((fromPos.Y - _vxOrigin.Y) / sz),
            z = _vxFloor((fromPos.Z - _vxOrigin.Z) / sz),
        }
        local goalCell = {
            x = _vxFloor((toPos.X - _vxOrigin.X) / sz),
            y = _vxFloor((toPos.Y - _vxOrigin.Y) / sz),
            z = _vxFloor((toPos.Z - _vxOrigin.Z) / sz),
        }

        local path = _vxAStar(sz, startCell, goalCell, fromPos, toPos)
        if not path then return nil end
        path = _vxSimplify(path, inflate, height)
        if not path or #path == 0 then return nil end

        local route = {}
        for idx = 2, #path do route[#route + 1] = path[idx] end
        if #route == 0 or (route[#route] - toPos).Magnitude > 0.5 then
            route[#route + 1] = toPos
        end
        return route
    end

    end
    local function _routeClear(pts)
        local n = #pts
        for i = 1, n - 1 do
            local a, b = pts[i], pts[i + 1]
            if (a - b).Magnitude > 0.5 then
                local sA = (i == 1) and _ENDPOINT_SLACK or 0
                local sB = (i == n - 1) and _ENDPOINT_SLACK or 0
                if not _clearWide(a, b, sA, sB) then return false end
            end
        end
        return true
    end
    -- collapse zigzag almost-straight paths into 1 segment when possible
    local function _straightenRoute(fromPos, pts, toPos)
        if not pts or #pts == 0 then return { toPos } end
        local dest = toPos or pts[#pts]
        if _clearWide(fromPos, dest) or _clear(fromPos, dest) then
            return { dest }
        end
        -- elevated straight (souvent libre alors que le sol ne l'est pas)
        local cruiseY = math.max(fromPos.Y, dest.Y) + 10
        local elevHigh = Vector3.new(fromPos.X, cruiseY, fromPos.Z)
        local elevOver = Vector3.new(dest.X, cruiseY, dest.Z)
        if _clearWide(elevHigh, elevOver) or _clear(elevHigh, elevOver) then
            -- 1 segment vers la dest (pas up/over/down)
            return { dest }
        end
        if #pts <= 2 then return pts end
        local out = { pts[1] }
        for i = 2, #pts - 1 do
            local a, p, b = out[#out], pts[i], pts[i + 1]
            local d = b - a
            local len2 = d.X * d.X + d.Y * d.Y + d.Z * d.Z
            if len2 < 0.25 then
                -- skip
            else
                local t = math.clamp((p - a):Dot(d) / len2, 0, 1)
                local proj = a + d * t
                if (p - proj).Magnitude > 5 then
                    out[#out + 1] = p
                end
            end
        end
        out[#out + 1] = pts[#pts]
        if (out[#out] - dest).Magnitude > 0.5 then out[#out + 1] = dest end
        if #out > 1 and (_clearWide(fromPos, dest) or _clear(fromPos, dest)) then
            return { dest }
        end
        return out
    end
    local function computeRoute(fromPos, toPos, facingDir)
        -- 1) vraie ligne droite d'abord (wide puis ray fin comme Vanish)
        if _clearWide(fromPos, toPos) then return { toPos } end
        if _clear(fromPos, toPos) then return { toPos } end

        local entry = facingDir and (toPos - facingDir * 14) or toPos

        local cruiseY = math.max(fromPos.Y, toPos.Y, 26) + 12
        local crest = { fromPos, Vector3.new(fromPos.X, cruiseY, fromPos.Z),
                        Vector3.new(toPos.X, cruiseY, toPos.Z), toPos }
        if _routeClear(crest) then
            -- crest libre = ligne droite en diagonal (carpet), 1 waypoint pas 3
            return { toPos }
        end

        local okV, vr = pcall(voxelRoute, fromPos, toPos)
        if okV and vr and #vr > 0 then
            return _straightenRoute(fromPos, vr, toPos)
        end

        local best, bestLen = nil, math.huge
        local function consider(pts)
            if not pts or #pts < 2 then return end
            if not _routeClear(pts) then return end
            local pulled = _pullWide(pts)
            local L = 0
            for i = 1, #pulled - 1 do L = L + (pulled[i + 1] - pulled[i]).Magnitude end
            if L < bestLen then best, bestLen = pulled, L end
        end
        local dirF = Vector3.new(entry.X - fromPos.X, 0, entry.Z - fromPos.Z)
        if dirF.Magnitude > 0.1 then
            dirF = dirF.Unit
            local perp = Vector3.new(-dirF.Z, 0, dirF.X)
            local midBase = (fromPos + entry) * 0.5
            for _, off in ipairs({ 14, -14, 24, -24, 38, -38, 56, -56, 76, -76 }) do
                consider({ fromPos, midBase + perp * off, entry })
                consider({ fromPos, fromPos + perp * off, entry + perp * off, entry })
            end
        end
        if best then
            best[#best + 1] = toPos
            return _straightenRoute(fromPos, best, toPos)
        end

        -- dernier recours pathfinder, mais on rechute en droite si possible
        if _clear(fromPos, toPos) then return { toPos } end

        local groundTo = Vector3.new(entry.X, fromPos.Y, entry.Z)
        local path = PathfindingService:CreatePath({
            AgentRadius = 12, AgentHeight = 5, AgentCanJump = true, AgentJumpHeight = 10, AgentMaxSlope = 89,
        })
        local FLOAT = 3
        local nav = { fromPos }
        local ok = pcall(function()
            path:ComputeAsync(Vector3.new(fromPos.X, fromPos.Y, fromPos.Z), groundTo)
        end)
        if ok and path.Status == Enum.PathStatus.Success then
            local last = fromPos
            for _, wp in ipairs(path:GetWaypoints()) do
                if (wp.Position - last).Magnitude >= 140 then
                    nav[#nav + 1] = wp.Position + Vector3.new(0, FLOAT, 0); last = wp.Position
                end
            end
        end
        nav[#nav + 1] = entry + Vector3.new(0, FLOAT, 0)
        nav = _pushOffWalls(nav)
        local route = _pullWide(nav)
        route = _pullWide(route)
        route[#route + 1] = toPos
        return _straightenRoute(fromPos, route, toPos)
    end
    local function buildApproachWaypoints(fromPos, destPos, facingDir)
        local startY, destY = fromPos.Y, destPos.Y
        local upperApproach = destY > 10 and startY < destY - 3
        if not upperApproach and (_clearWide(fromPos, destPos) or _clear(fromPos, destPos)) then
            return { destPos }, true
        end
        local route = computeRoute(fromPos, destPos, facingDir)
        if not route or #route == 0 then return { destPos }, true end
        route = _straightenRoute(fromPos, route, destPos)
        -- ligne droite (1 wp) : pas de découpe montée, sinon 3+ waypoints "droits"
        if #route <= 1 then return { destPos }, true end
        local ASCEND_STEP = 10
        local stepped = {}
        local prev = fromPos
        for _, wp in ipairs(route) do
            local dy = wp.Y - prev.Y
            if dy > ASCEND_STEP * 1.5 then
                local n = math.ceil(dy / ASCEND_STEP)
                for st = 1, n - 1 do
                    local t = st / n
                    stepped[#stepped + 1] = Vector3.new(
                        prev.X + (wp.X - prev.X) * t,
                        prev.Y + dy * t,
                        prev.Z + (wp.Z - prev.Z) * t
                    )
                end
            end
            stepped[#stepped + 1] = wp
            prev = wp
        end
        if #stepped == 0 then stepped = { destPos } end
        return stepped, true
    end
    -- Vanish doClone + swap place avec le clone (UI TeleportToClone = chemin jeu)
    local function doClone()
        pcall(loadNet)
        local char = player.Character or player.CharacterAdded:Wait()
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then return false end
        local cloner = (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Quantum Cloner"))
                    or char:FindFirstChild("Quantum Cloner")
        if not cloner then return false end
        if cloner.Parent ~= char then
            pcall(function() hum:EquipTool(cloner) end)
            task.wait(0.05)
        end

        local prePos
        do
            local h = char:FindFirstChild("HumanoidRootPart")
            prePos = h and h.Position
        end

        -- 1) spawn clone
        local useItem = remoteOf("UseItem", 0) or _G.__tpUseItemRemote or getRemote("RemoteEvent", "UseItem")
        if useItem then
            pcall(function() useItem:FireServer() end)
        else
            pcall(function() cloner:Activate() end)
        end

        local cloneName = tostring(player.UserId) .. "_Clone"
        local _t0 = os.clock()
        while not workspace:FindFirstChild(cloneName) and os.clock() - _t0 < 1.0 do
            RunService.Heartbeat:Wait()
        end
        if not workspace:FindFirstChild(cloneName) then
            if _G.SXE_Trace then _G.SXE_Trace("doClone:no clone model") end
            return false
        end
        task.wait(0.05)

        -- keep tool equipped for swap
        char = player.Character
        hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and cloner and cloner.Parent and cloner.Parent ~= char then
            pcall(function() hum:EquipTool(cloner) end)
            task.wait(0.03)
        end

        -- 2) SWAP via game UI (reliable) — comme instantClone OPTI
        local swapped = false
        local tpButton = PlayerGui:FindFirstChild("ToolsFrames")
            and PlayerGui.ToolsFrames:FindFirstChild("QuantumCloner")
            and PlayerGui.ToolsFrames.QuantumCloner:FindFirstChild("TeleportToClone")
        if not tpButton then
            -- show UI by activating tool
            pcall(function() cloner:Activate() end)
            task.wait(0.08)
            tpButton = PlayerGui:FindFirstChild("ToolsFrames")
                and PlayerGui.ToolsFrames:FindFirstChild("QuantumCloner")
                and PlayerGui.ToolsFrames.QuantumCloner:FindFirstChild("TeleportToClone")
        end
        if tpButton then
            pcall(function() tpButton.Visible = true end)
            if typeof(firesignal) == "function" then
                pcall(function() firesignal(tpButton.MouseButton1Up) end)
                pcall(function() firesignal(tpButton.MouseButton1Click) end)
                pcall(function() firesignal(tpButton.Activated) end)
                swapped = true
            elseif typeof(getconnections) == "function" then
                for _, sig in ipairs({tpButton.MouseButton1Click, tpButton.MouseButton1Up, tpButton.Activated}) do
                    local ok, conns = pcall(getconnections, sig)
                    if ok and type(conns) == "table" then
                        for _, c in ipairs(conns) do
                            pcall(function()
                                if c.Fire then c:Fire()
                                elseif c.Function then c.Function()
                                end
                            end)
                        end
                    end
                end
                swapped = true
            else
                local inset = GuiService:GetGuiInset()
                local pos = tpButton.AbsolutePosition + tpButton.AbsoluteSize / 2 + inset
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                task.wait()
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                swapped = true
            end
        end

        -- 3) fallback remote OnTeleport (exact cache only)
        if not swapped then
            local onTel = _G.__tpOnTelRemote or remoteOf("QuantumCloner/OnTeleport", 0.25)
            if onTel then
                swapped = pcall(function() onTel:FireServer() end)
            end
        end

        -- wait until position swapped / clone consumed
        local _t1 = os.clock()
        while os.clock() - _t1 < 1.0 do
            local h = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if h and prePos then
                local d = h.Position - prePos
                if (d.X * d.X + d.Z * d.Z) > 4 then
                    if _G.SXE_Trace then _G.SXE_Trace("doClone:swapped") end
                    return true
                end
            end
            if not workspace:FindFirstChild(cloneName) then
                return true
            end
            RunService.Heartbeat:Wait()
        end
        if _G.SXE_Trace then _G.SXE_Trace("doClone:swap timeout swappedFlag=" .. tostring(swapped)) end
        return swapped
    end
    -- Move go-to-brainrot (unused post-clone Vanish; keep for elsewhere)
    local function vanishVelMoveThrough(hrp, waypoints, speedOverride)
        if not hrp or not hrp.Parent or not waypoints or #waypoints == 0 then return end
        local _runSpeed = math.clamp(tonumber(speedOverride) or 400, 200, 600)
        local wpIdx = 1
        local done = false
        local conn
        local function finish()
            if done then return end
            done = true
            if hrp and hrp.Parent then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
            if conn then conn:Disconnect() end
        end
        local lastDist, stall = math.huge, 0
        local ARRIVE_V = 3
        conn = RunService.Heartbeat:Connect(function()
            if not hrp or not hrp.Parent or done then
                if conn then conn:Disconnect() end
                return
            end
            if _G.VanishTPStop then finish() return end
            pcall(equipCarpet)
            local target = waypoints[wpIdx]
            if not target then finish() return end
            local diff = target - hrp.Position
            local mag = diff.Magnitude
            local _arr = math.max(ARRIVE_V, _runSpeed / 60 * 1.25)
            if mag < _arr then
                wpIdx = wpIdx + 1
                if wpIdx > #waypoints then finish() return end
                lastDist, stall = math.huge, 0
                target = waypoints[wpIdx]
                diff = target - hrp.Position
                mag = diff.Magnitude
            end
            if mag > lastDist - 0.05 then stall = stall + 1 else stall = 0 end
            lastDist = mag
            if stall >= 60 then finish() return end
            if mag >= 0.1 then
                local dir = diff.Unit
                if diff.Y > 5 then
                    local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local st = hum:GetState()
                        if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then
                            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                            pcall(function() hum.Jump = true end)
                        end
                    end
                end
                -- pleine vitesse GoSpeed, pas de frein climb/corner
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * _runSpeed, dir.Y * _runSpeed, dir.Z * _runSpeed)
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end)
        local totalDist = 0
        local prev = hrp.Position
        for _, wp in ipairs(waypoints) do
            totalDist = totalDist + (prev - wp).Magnitude
            prev = wp
        end
        local timeout = totalDist / math.max(_runSpeed, 1) + 2
        local elapsed = 0
        while not done and elapsed < timeout do
            task.wait(0.05)
            elapsed = elapsed + 0.05
        end
        finish()
        vZero(hrp)
    end
    -- Vanish goToBrainrot (route exacte) + move full-speed
    local function goToBrainrot(petPos, slot)
        if not petPos then return end
