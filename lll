        if hit and hit.Parent then return hit end
        if name == "UseItem" and _G.__tpUseItemRemote and _G.__tpUseItemRemote.Parent then
            return _G.__tpUseItemRemote
        end
        if name == "QuantumCloner/OnTeleport" and _G.__tpOnTelRemote and _G.__tpOnTelRemote.Parent then
            return _G.__tpOnTelRemote
        end
