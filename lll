    local function digOnce(fn)
        if type(fn) ~= "function" then return end
        local plots = workspace:FindFirstChild("Plots")
        local names = {}
        if plots then
            for _, p in ipairs(plots:GetChildren()) do names[p.Name] = true end
        end
        local function consider(v, depth)
            if depth > 2 or type(v) ~= "table" then return end
            local hits = 0
            for k, ch in pairs(v) do
                if type(k) == "string" and names[k] and type(ch) == "table" then
                    remember(k, ch)
                    hits = hits + 1
                end
            end
            if hits == 0 and depth < 2 then
                local n = 0
