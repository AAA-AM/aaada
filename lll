-- =====================================================================
-- SAFE GENERATION READER (no GetGeneration / no AnimalsShared)
-- =====================================================================
-- The game renders each brainrot's income ("$X/s") on an overhead GUI label on
-- its podium. Reading that TextLabel.Text is fully passive -- the same kind of
-- read the script already does on PlotSign labels -- so it carries NO detection
-- risk, unlike AnimalsShared:GetGeneration (which the author disabled). We locate
-- the podium, find the label whose text contains "/s", and parse it to a number.
local _SUFFIX_MULT = { k=1e3, m=1e6, b=1e9, t=1e12, qa=1e15, q=1e15 }
local function _parseGenText(txt)
    if not txt or txt == "" then return 0 end
    -- normalize: keep digits, dot, and suffix letters; find the "<num><suffix>/s" bit
    local num, suf = txt:lower():gsub(",", ""):match("([%d%.]+)%s*([kmbtqa]*)/s")
    if not num then
        num, suf = txt:lower():gsub(",", ""):match("%$%s*([%d%.]+)%s*([kmbtqa]*)")
    end
    local n = tonumber(num)
    if not n then return 0 end
    if suf and suf ~= "" and _SUFFIX_MULT[suf] then n = n * _SUFFIX_MULT[suf] end
    return n
end
local _genCache, _genCacheAt = {}, {}
-- reads "$X/s" from a podium's overhead display. Returns (displayText, numericValue).
-- The income label is a GUI somewhere near the podium; the game names/nests these
-- unpredictably (like the timer's "RemainingTime" billboard), so instead of guessing
-- a name we scan the podium AND its base-part's area for ANY GUI text that parses to
-- a "$X/s" value, and take the largest match. Passive read only -- no module calls.
function readPodiumGen(plotName, slot)
    local ck = tostring(plotName) .. "_" .. tostring(slot)
    local hit = _genCache[ck]
    if hit and (os.clock() - (_genCacheAt[ck] or 0)) < 3 then return hit[1], hit[2] end
    local plots = Workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild(plotName)
    if not plot then return nil, 0 end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    local podium = podiums and podiums:FindFirstChild(tostring(slot))
    if not podium then return nil, 0 end
    local bestText, bestVal = nil, 0
    local function scanFor(root)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and type(d.Text) == "string" then
                local t = d.Text
                -- must look like a per-second income, not a name/timer:
                -- contains a digit AND ("/s" or "$"), and is NOT a mm:ss timer.
                if (t:find("/s") or t:find("%$")) and t:find("%d") and not t:find(":") then
                    local v = _parseGenText(t)
                    if v > bestVal then bestVal = v; bestText = t end
                end
            end
        end
    end
    local ok = pcall(function()
        -- 1) the podium subtree itself
        scanFor(podium)
        -- 2) BillboardGuis in the plot adorned near this podium's base (the game
