_G._SabcomSliderDragging = false

local function MakeDraggable(handle, target, saveKey)

    local dragging = false
    local dragOffset = Vector2.new(0, 0)

    local function stopDrag()
        if not dragging then return end
        dragging = false
        if saveKey then
            local absE = target.AbsolutePosition
            if not Config.SabcomPositions then Config.SabcomPositions = {} end
            Config.SabcomPositions[saveKey] = {xs=0, xo=absE.X, ys=0, yo=absE.Y}
            local ps = workspace.CurrentCamera.ViewportSize
            if not Config.Positions then Config.Positions = {} end
            Config.Positions[saveKey] = {X = absE.X / ps.X, Y = absE.Y / ps.Y}
            SaveConfig()
        end
    end

    handle.InputBegan:Connect(function(input)
        if Config.UILocked then return end
        if _G._SabcomSliderDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true

            local abs = target.AbsolutePosition
            target.Position = UDim2.fromOffset(abs.X, abs.Y)
            local m = UIS:GetMouseLocation()
            dragOffset = Vector2.new(m.X - abs.X, m.Y - abs.Y)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then stopDrag() end
            end)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            stopDrag()
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not dragging or Config.UILocked or _G._SabcomSliderDragging then return end
        local m = UIS:GetMouseLocation()
        target.Position = UDim2.fromOffset(m.X - dragOffset.X, m.Y - dragOffset.Y)
    end)
end
