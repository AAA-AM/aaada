    local function clear()
        if force then pcall(function() force:Destroy() end); force = nil end
        if att then pcall(function() att:Destroy() end); att = nil end
    end
    local function build(hrp)
        clear()
        att = Instance.new("Attachment")
        att.Parent = hrp
        force = Instance.new("LinearVelocity")
        force.Attachment0            = att
        force.RelativeTo             = Enum.ActuatorRelativeTo.World
        force.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        force.ForceLimitMode         = Enum.ForceLimitMode.PerAxis
        force.MaxAxesForce           = Vector3.new(math.huge, 0, math.huge)
        force.MaxForce               = math.huge
        force.ReactionForceEnabled   = true
        force.VectorVelocity         = Vector3.zero
        force.Enabled                = false
        force.Parent                 = hrp
    end
    _G.__wsClearBoost = clear
    _G.__wsApplyBoost = function(hum, root, targetSpeed)
        if not hum or not root or hum.Health <= 0 then clear(); return end
        if not force or force.Parent ~= root then build(root) end
        local spd = math.clamp(tonumber(targetSpeed) or 0, 5, 60)
        local flat = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
        if flat.Magnitude > 1e-3 then
            local dir = flat.Unit
            force.VectorVelocity = Vector3.new(dir.X * spd, 0, dir.Z * spd)
            if not force.Enabled then force.Enabled = true end
        elseif force.Enabled then
            force.Enabled = false
        end
    end
end

