	local EXCLUDE = { control = true }
	local COOLDOWNS = {
		ragdoll = 30, jail = 60, rocket = 120, balloon = 30, inverse = 30,
		jumpscare = 30, tiny = 30, morph = 30, nightvision = 30, control = 30,
	}
	local lastUse = {}
