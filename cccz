        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local best, bestDist = nil, math.huge
        local radius = Config.AutoBuyRange or 17
        for _, e in ipairs(animals) do
            if e.prompt and e.prompt.Parent and e.prompt.Enabled
            and e.part and e.part.Parent then
                local d = (hrp.Position - e.part.Position).Magnitude
                if d < radius and d < bestDist then bestDist=d; best=e end
            end
        end
        if best then
            abLockedTarget=best; abLockedPart=best.part
            abLockedModel=best.model or best.part.Parent
            pcall(function() best.prompt.HoldDuration = 0 end)
            abResolvePurchaseRemote(); abStartCarpetLock()
            abFirePurchase(best.prompt)
            best.prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
                if best.prompt.Enabled and autoBuyActive then abFirePurchase(best.prompt) end
            end)
            ShowNotification("AUTO BUY", "Locked: " .. (best.name or "target"))
        end
    end
end)

