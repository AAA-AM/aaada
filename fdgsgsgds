local function isSpyderHubGui(instance)
    local parent = instance
    for _ = 1, 10 do
        if not parent then break end
        if parent.Name == "SpyderHubGui" then return true end
        parent = parent.Parent
    end
    return false
end

local function isVisibleChain(instance)
    local current = instance
    while current do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") then return current.Enabled end
        current = current.Parent
    end
    return true
end

local function findAllTextBoxes(playerGuiInstance)
    local boxes = {}
    for _, gui in ipairs(playerGuiInstance:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "SpyderHubGui" then
            for _, descendant in ipairs(gui:GetDescendants()) do
                if descendant:IsA("TextBox") and not isSpyderHubGui(descendant) then
                    boxes[#boxes + 1] = descendant
                end
            end
        end
    end
    return boxes
end

local function findCodeButtons(playerGuiInstance)
    local buttons = {}
    for _, gui in ipairs(playerGuiInstance:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "SpyderHubGui" then
            for _, descendant in ipairs(gui:GetDescendants()) do
                if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and not isSpyderHubGui(descendant) then
                    local name = descendant.Name:lower()
                    local parentName = (descendant.Parent and descendant.Parent.Name or ""):lower()
                    if (name:find("code") or name:find("redeem") or parentName:find("code") or parentName:find("redeem")) and isVisibleChain(descendant) then
                        buttons[#buttons + 1] = descendant
                    end
                end
            end
        end
    end
    return buttons
end

local function clickButton(button)
    if not button then return false end
    local methods = {
        function() button.MouseButton1Click:Fire() end,
        function() button.Activated:Fire() end
    }
    if typeof(firesignal) == "function" then
        table.insert(methods, function() firesignal(button.MouseButton1Click) end)
        table.insert(methods, function() firesignal(button.Activated) end)
    end
    if typeof(getConnections) == "function" then
        table.insert(methods, function()
            local success, connections = pcall(getConnections, button.MouseButton1Click)
            if success and type(connections) == "table" then for _, conn in ipairs(connections) do pcall(function() conn:Fire() end) end end
            local success2, connections2 = pcall(getConnections, button.Activated)
            if success2 and type(connections2) == "table" then for _, conn in ipairs(connections2) do pcall(function() conn:Fire() end) end end
        end)
    end
    if typeof(fireclick) == "function" then table.insert(methods, function() fireclick(button) end) end
    local anySuccess = false
    for _, method in ipairs(methods) do local success = pcall(method); anySuccess = anySuccess or success end
    return anySuccess
end

local function writeCodeToBox(box, code)
    if not box then return false end
    pcall(function() box.Text = code end)
    return box.Text == code
end

local function fireBoxFocusLost(box)
    if not box then return false end
    local anyFired = false
    if typeof(firesignal) == "function" then
        local success = pcall(firesignal, box.FocusLost, true)
        anyFired = anyFired or success
    end
    if typeof(getConnections) == "function" then
        local success, connections = pcall(getConnections, box.FocusLost)
        if success and type(connections) == "table" then
            for _, conn in ipairs(connections) do
                local func
                pcall(function() func = conn.Function end)
                if func and typeof(getUpvalues) == "function" and typeof(setupUpvalue) == "function" then
                    local upSuccess, upvalues = pcall(getUpvalues, func)
                    if upSuccess and type(upvalues) == "table" then
                        for index, value in pairs(upvalues) do
                            if type(value) == "boolean" and value == true then pcall(setupUpvalue, func, index, false) end
                        end
                    end
                end
                local fireSuccess = pcall(function() if conn.Enabled ~= false then conn:Fire(true) end end)
                anyFired = anyFired or fireSuccess
            end
        end
    end
    return anyFired
end

local function typeAndSubmitCode(code)
    if not localPlayer then return false end
    local pg = localPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end

    local codesGui = pg:FindFirstChild("Codes")
    if codesGui then
        if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
        local codesFrame = codesGui:FindFirstChild("Codes") or codesGui
        if codesFrame then
            if codesFrame:IsA("GuiObject") then codesFrame.Visible = true end
            local current = codesFrame
            while current and current ~= codesGui do
                if current:IsA("GuiObject") then current.Visible = true end
                current = current.Parent
            end
            local box = nil
            for _, descendant in ipairs(codesFrame:GetDescendants()) do
                if descendant:IsA("TextBox") and not isSpyderHubGui(descendant) then box = descendant; break end
            end
            local submitButton = nil
            for _, descendant in ipairs(codesFrame:GetDescendants()) do
                if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and not isSpyderHubGui(descendant) then
                    local name = descendant.Name:lower(); local text = ""
                    pcall(function() text = descendant.Text:lower() end)
                    if name:find("submit") or text:find("submit") or name:find("redeem") or text:find("redeem") or name:find("claim") or text:find("confirm") or name:find("enter") then
                        submitButton = descendant; break
                    end
                end
            end
            if not submitButton then
                for _, descendant in ipairs(codesFrame:GetDescendants()) do
                    if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and not isSpyderHubGui(descendant) then
                        local name = descendant.Name:lower()
                        if not name:find("close") and not name:find("x") and not name:find("toggle") then submitButton = descendant; break end
                    end
                end
            end
            if box then
                writeCodeToBox(box, code); task.wait(0.05)
                if submitButton then clickButton(submitButton) end
                fireBoxFocusLost(box); playRedeemAudio()
                return true
            end
        end
    end

    local buttons = findCodeButtons(pg)
    for _, button in ipairs(buttons) do clickButton(button); task.wait(0.05) end
    task.wait(0.3)

    local box = nil
    local deadline = tick() + 3
    while tick() < deadline do
        local allBoxes = findAllTextBoxes(pg)
        for _, descendant in ipairs(allBoxes) do
            if isVisibleChain(descendant) then
                local name = descendant.Name:lower(); local parentName = (descendant.Parent and descendant.Parent.Name or ""):lower()
                if name:find("code") or parentName:find("code") or name:find("redeem") or parentName:find("redeem")
                    or name:find("input") or parentName:find("input") or name:find("textbox") or name:find("enter") then
                    box = descendant; break
                end
            end
        end
        if not box then
            for _, descendant in ipairs(findAllTextBoxes(pg)) do
                if isVisibleChain(descendant) then box = descendant; break end
            end
        end
        if box then break end
        task.wait(0.1)
    end

    if not box then return false end
    writeCodeToBox(box, code); task.wait(0.05)

    local redeemButton = nil
    local searchNames = {"submit","redeem","claim","confirm","enter","send","apply","ok","use","go","check"}
    local parent = box.Parent
    for _ = 1, 8 do
        if not parent then break end
        for _, descendant in ipairs(parent:GetDescendants()) do
            if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and not isSpyderHubGui(descendant) and descendant ~= box then
                local name = descendant.Name:lower(); local text = ""
                pcall(function() text = descendant.Text:lower() end)
                for _, searchName in ipairs(searchNames) do
                    if name:find(searchName) or text:find(searchName) then
                        if isVisibleChain(descendant) then redeemButton = descendant; break end
                    end
                end
                if redeemButton then break end
            end
        end
        if redeemButton then break end
        parent = parent.Parent
    end
    if redeemButton then clickButton(redeemButton) end
    fireBoxFocusLost(box); playRedeemAudio()
    return true
end

local function resolveNotifyRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local success, netFolder = pcall(function()
        return ReplicatedStorage:WaitForChild("Packages", 2):WaitForChild("Net", 2)
    end)
    local getInfo = debug and (debug.getinfo or debug.info)
    local function checkRemote(descendant)
        if not descendant:IsA("RemoteEvent") then return nil end
        local lowerName = descendant.Name:lower()
        if lowerName:find("notif") or lowerName:find("announce") or lowerName:find("message") or lowerName:find("chat") or lowerName:find("global") then
            return descendant
        end
        if getgc and getInfo and getConnections then
            local success2, connections = pcall(getConnections, descendant.OnClientEvent)
            if success2 and connections then
                for _, conn in ipairs(connections) do
                    local funcSuccess, func = pcall(function() return conn.Function end)
                    if funcSuccess and type(func) == "function" then
                        local infoSuccess, info = pcall(getInfo, func)
                        if infoSuccess then
                            local source = tostring(info.short_src or info.source or "")
                            if source:find("Notification", 1, true) or source:find("Announce", 1, true) or source:find("Chat", 1, true) then
                                return descendant
                            end
                        end
                    end
                end
            end
        end
        return nil
    end
    if success and netFolder then
        for _, descendant in ipairs(netFolder:GetDescendants()) do
            local remote = checkRemote(descendant)
            if remote then return remote end
        end
    end
    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        local remote = checkRemote(descendant)
        if remote then return remote end
    end
    return nil
end

