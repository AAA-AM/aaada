local fpsBuffer = {}
local fpsFlush = 0

RunService.RenderStepped:Connect(function(dt)
    if dt > 0 then
        fpsBuffer[#fpsBuffer + 1] = 1 / dt
    end
    fpsFlush += dt
    if fpsFlush >= 0.35 and #fpsBuffer > 0 then
        fpsFlush = 0
        local sum = 0
        for i = 1, #fpsBuffer do sum += fpsBuffer[i] end
        local avg = math.round(sum / #fpsBuffer)
        fpsBuffer = {}
        fpsPill.Text = "FPS " .. avg
        fpsPill.TextColor3 = avg >= 55 and colors.green or avg >= 30 and colors.yellow or colors.red
    end
end)

