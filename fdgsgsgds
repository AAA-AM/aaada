        statusDot.BackgroundColor3 = colors.green
        codeBuffer = {}; updatePreview()
        print("[Spyder Hub] scan ON")
    else
        scanBtn.Text = "START SCAN"
        TweenService:Create(scanBtn, TweenInfo.new(0.18), {BackgroundColor3 = colors.btnBg}):Play()
        statusDot.BackgroundColor3 = colors.red
        codeBuffer = {}; updatePreview()
        print("[Spyder Hub] scan OFF")
    end
end

