                            if _plat and _plat.Parent then pcall(function() _plat:Destroy() end) end
                        end)
                    end
                else
                    local ty
                    if h >= -6.9 and h <= 8.9 then ty = -4
                    else ty = petPos.Y end
                    local function snapToSpot()
                        local _c = player.Character
                        local _h = _c and _c:FindFirstChild("HumanoidRootPart")
                        local _hum = _c and _c:FindFirstChildOfClass("Humanoid")
                        if _h and _h.Parent then
                            local off = 3
                            if _hum then off = _hum.HipHeight + _h.Size.Y * 0.5 end
                            pcall(function()
                                _h.CFrame = CFrame.new(petPos.X, ty + off, petPos.Z)
                                _h.AssemblyLinearVelocity = Vector3.zero
                                _h.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                    end
                    snapToSpot()
                    pcall(armSteal, pet)
                    local _s = tick()
                    while tick() - _s < _SNAP_HOLD do
                        if player:GetAttribute("Stealing") then break end
                        if _G.SXE_StealStatus and _G.SXE_StealStatus.active then break end
                        if _isCarrying() then break end
                        snapToSpot()
                        RunService.Heartbeat:Wait()
                    end
                end
            end
        end

        pcall(function() if healConn then healConn:Disconnect() end end)
        _lastTPOk = true
        endTP()
        return true
    end
