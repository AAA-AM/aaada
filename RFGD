            local _c = player.Character
            local _h = _c and _c:FindFirstChild("HumanoidRootPart")
            local plotsFolder = workspace:FindFirstChild("Plots")
            if _h and plotsFolder then
                local _rad = (petPos.Y <= 8.9) and 28 or 26
                local p = _h.Position
                -- Проверяем только плот ПИТОМЦА, не любой плот
                -- Это предотвращает false-positive когда клон бросает на свою базу
                local targetPlotName = pet and pet.plot
                for _, plot in ipairs(plotsFolder:GetChildren()) do
