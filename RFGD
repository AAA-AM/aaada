    tagLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    tagLbl.TextXAlignment = Enum.TextXAlignment.Center
end

local function enableESPBaseOwner()
    espBaseOwnerEnabled = true
    local lastOwnerName = nil
    local tickCount = 0
    espBaseOwnerConn = RunService.Heartbeat:Connect(function()
        if not espBaseOwnerEnabled then return end
        tickCount = tickCount + 1
        if tickCount < 60 then return end  -- actualizar ~cada 1s (60 Heartbeats)
        tickCount = 0

        local plot = _espGetPlotUnderPlayer()
        local ownerName = _espGetPlotOwnerName(plot)

        if ownerName == lastOwnerName then
            -- Si el owner no cambió pero el holder fue destruido (respawn/teleport), re-aplicar
            if ownerName and (not espBaseOwnerHolder or not espBaseOwnerHolder.Parent) then
                pcall(_espApplyBaseOwner, ownerName)
            end
            return
        end
        lastOwnerName = ownerName
        pcall(_espApplyBaseOwner, ownerName)
    end)
end

local function disableESPBaseOwner()
    espBaseOwnerEnabled = false
    if espBaseOwnerConn then espBaseOwnerConn:Disconnect(); espBaseOwnerConn = nil end
    _espBaseOwnerClear()
end

