    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            pcall(_espMakeBillboard, plr)
        end
    end
    local conn = Players.PlayerAdded:Connect(function(plr)
        if not espPlayerEnabled then return end
        task.wait(1)
        pcall(_espMakeBillboard, plr)
    end)
    table.insert(espPlayerConnections, conn)
    local conn2 = Players.PlayerRemoving:Connect(function(plr)
        if espPlayerHighlights[plr] then
            pcall(function() espPlayerHighlights[plr].billboard:Destroy() end)
            espPlayerHighlights[plr] = nil
        end
    end)
    table.insert(espPlayerConnections, conn2)
end

local function disableESPPlayer()
    espPlayerEnabled = false
    for _, conn in ipairs(espPlayerConnections) do
        if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
    end
    espPlayerConnections = {}
    for plr, data in pairs(espPlayerHighlights) do
        pcall(function() data.billboard:Destroy() end)
    end
    espPlayerHighlights = {}
end

-- =====================================================================
-- ESP BASE OWNER (ESP + label "BASE OWNER" sobre el personaje del owner
--                 del plot en el que está parado el jugador local)
-- =====================================================================
local espBaseOwnerEnabled = false
local espBaseOwnerConn = nil
local espBaseOwnerHolder = nil  -- ScreenGui activo

-- Devuelve el plot (Model) más cercano al jugador local por posición XZ
local function _espGetPlotUnderPlayer()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local ok, cf = pcall(function() return plot:GetPivot() end)
        if ok and cf then
            local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(cf.Position.X, 0, cf.Position.Z)).Magnitude
            if d < nearestDist then nearestDist = d; nearest = plot end
        else
            -- fallback: usar PlotSign si no hay pivot
            local sign = plot:FindFirstChild("PlotSign")
            local sp = sign and (sign:IsA("BasePart") and sign or sign:FindFirstChildWhichIsA("BasePart", true))
            if sp then
                local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(sp.Position.X, 0, sp.Position.Z)).Magnitude
                if d < nearestDist then nearestDist = d; nearest = plot end
            end
        end
    end
    return nearest
end

-- Obtiene el nombre del owner de un plot usando el canal SXE o el PlotSign
local function _espGetPlotOwnerName(plot)
    if not plot then return nil end
    -- Intentar via canal SXE
    local ch = _G.SXE_GetPlotChannel and _G.SXE_GetPlotChannel(plot.Name)
    if ch then
        local o = _G.SXE_ChannelGet and _G.SXE_ChannelGet(ch, "Owner")
        if typeof(o) == "Instance" and o:IsA("Player") then return o.Name end
        if type(o) == "table" and o.Name then return tostring(o.Name) end
        if type(o) == "string" and o ~= "" then return o end
        if type(o) == "number" then
            local p = Players:GetPlayerByUserId(o)
            if p then return p.Name end
        end
    end
    -- Fallback: leer el texto del PlotSign (igual que findNearestBaseOwner)
    local sign = plot:FindFirstChild("PlotSign")
    local lbl = sign and sign:FindFirstChild("SurfaceGui") and sign.SurfaceGui:FindFirstChild("Frame") and sign.SurfaceGui.Frame:FindFirstChild("TextLabel")
    if lbl then
        local nick = lbl.Text:match("^(.-)'") or lbl.Text
        if nick and nick ~= "" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.DisplayName == nick or p.Name == nick then return p.Name end
            end
        end
    end
    return nil
end

-- Limpia el ESP de base owner anterior
local function _espBaseOwnerClear()
    if espBaseOwnerHolder then
        pcall(function() espBaseOwnerHolder:Destroy() end)
        espBaseOwnerHolder = nil
    end
    -- Limpiar cualquier vestigio por nombre
    for _, sg in ipairs(PlayerGui:GetChildren()) do
        if sg.Name == "SXEEspBaseOwner" then pcall(function() sg:Destroy() end) end
    end
end

-- Aplica ESP + BillboardGui al personaje del owner
