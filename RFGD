                    -- Если знаем плот питомца — проверяем только его
                    if targetPlotName and plot.Name ~= tostring(targetPlotName) then continue end
                    pcall(function()
                        local pp = plot:GetPivot().Position
                        if math.abs(p.X - pp.X) < _rad and math.abs(p.Z - pp.Z) < _rad then
                            _insidePlot = true
                        end
                    end)
                    if _insidePlot then break end
                end
            end
            -- Если cloneOk и позиция рядом с destPos — считаем что внутри
            if not _insidePlot and _cloneOk then
                local _h2 = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if _h2 and (_h2.Position - destPos).Magnitude < 35 then
