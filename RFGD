                        if player:GetAttribute("Stealing") then break end
                        if _G.SXE_StealStatus and _G.SXE_StealStatus.active then break end
                        snapToSpot()
                        RunService.Heartbeat:Wait()
                    end
                    if _plat and _plat.Parent then
