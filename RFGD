    -- ── FIX: Brainrot visible mientras está sostenido ────────────────
    -- LocalTransparencyModifier es reseteado por el engine cada frame cuando
    -- el character sostiene un tool, por eso el one-shot no basta.
    -- Solución: loop RenderStepped que fuerza LTM=0 en el tool equipado
    -- actualmente, siempre que no sea el carpet ni el cloner.

    local CARPET_NAMES = {
        ["Flying Carpet"] = true,
        ["Quantum Cloner"] = true,
    }

    local _brainrotLoopConn = nil

    local function _forceToolVisible(tool)
        if not tool or not tool:IsA("Tool") then return end
        pcall(function()
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("UnionOperation") or part:IsA("MeshPart") then
                    part.LocalTransparencyModifier = 0
                    if part.Transparency >= 0.99 then
                        part.Transparency = 0
                    end
                end
            end
            local handle = tool:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                handle.LocalTransparencyModifier = 0
                if handle.Transparency >= 0.99 then
                    handle.Transparency = 0
                end
            end
        end)
    end

    local function _startBrainrotVisLoop()
        if _brainrotLoopConn then return end
        _brainrotLoopConn = RunService.RenderStepped:Connect(function()
            local char = player.Character
            if not char then return end
            -- Buscar el tool actualmente equipado (hijo del character, no del backpack)
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") and not CARPET_NAMES[child.Name] then
                    _forceToolVisible(child)
                end
            end
        end)
    end

    local function _stopBrainrotVisLoop()
        if _brainrotLoopConn then
            _brainrotLoopConn:Disconnect()
            _brainrotLoopConn = nil
