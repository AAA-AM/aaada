-- Buy loop
RunService.Heartbeat:Connect(function()
    if not autoBuyActive or not abPartAlive() or not abPromptAlive() then return end
    abFirePurchase(abLockedTarget.prompt)
end)

local function abScanConveyor()
    local results = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not (obj:IsA("ProximityPrompt") and obj.Enabled) then continue end
        local tx = (obj.ActionText or ""):lower()
        if not (tx:find("purchase") or tx:find("comprar") or tx:find("buy")) then continue end
        local part = obj.Parent
        if not part then continue end
        local realPart = part:IsA("Attachment") and part.Parent or part
        if not (realPart and realPart:IsA("BasePart")) then continue end
        local model, cur = nil, realPart
        for _ = 1, 8 do
            if cur and cur:IsA("Model") then model = cur; break end
            cur = cur and cur.Parent
        end
        table.insert(results, {prompt=obj, part=realPart, model=model})
    end
    return results
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if not autoBuyActive then
            abLockedTarget=nil; abLockedPart=nil; abLockedModel=nil
            abStopCarpetLock(); abDestroyBodyPos(); continue
        end
        if abLockedPart or abLockedModel then
            if not abPartAlive() then
                abLockedTarget=nil; abLockedPart=nil; abLockedModel=nil
                ShowNotification("AUTO BUY", "Rescanning...")
            end
            continue
        end
        local ok, found = pcall(abScanConveyor)
        local animals = (ok and found) or {}
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local best, bestDist = nil, math.huge
        local radius = Config.AutoBuyRange or 17
        for _, e in ipairs(animals) do
            if e.prompt and e.prompt.Parent and e.prompt.Enabled
            and e.part and e.part.Parent then
                local d = (hrp.Position - e.part.Position).Magnitude
                if d < radius and d < bestDist then bestDist=d; best=e end
            end
        end
        if best then
            abLockedTarget=best; abLockedPart=best.part
            abLockedModel=best.model or best.part.Parent
            pcall(function() best.prompt.HoldDuration = 0 end)
            abResolvePurchaseRemote(); abStartCarpetLock()
            abFirePurchase(best.prompt)
            best.prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
                if best.prompt.Enabled and autoBuyActive then abFirePurchase(best.prompt) end
            end)
            ShowNotification("AUTO BUY", "Locked: " .. (best.name or "target"))
        end
    end
end)

