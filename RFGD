    if not ownerName then return end

    local ownerPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == ownerName then ownerPlayer = p; break end
    end
    if not ownerPlayer or not ownerPlayer.Character then return end

    local char = ownerPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local holder = Instance.new("ScreenGui")
    holder.Name = "SXEEspBaseOwner"
    holder.ResetOnSpawn = false
    holder.Parent = PlayerGui
    espBaseOwnerHolder = holder

    -- Highlight sobre el personaje del owner
    local hl = Instance.new("Highlight", holder)
    hl.Adornee = char
    hl.FillColor = Color3.fromRGB(255, 220, 0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
    hl.OutlineTransparency = 0.0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    -- BillboardGui con label "BASE OWNER" sobre la cabeza
    local bb = Instance.new("BillboardGui", holder)
    bb.Adornee = hrp
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 200, 0, 44)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)

    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Size = UDim2.new(1, 0, 0.5, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = ownerName
    nameLbl.Font = Enum.Font.GothamBlack
    nameLbl.TextSize = 14
    nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLbl.TextStrokeTransparency = 0.3
    nameLbl.TextXAlignment = Enum.TextXAlignment.Center

    local tagLbl = Instance.new("TextLabel", bb)
    tagLbl.Size = UDim2.new(1, 0, 0.5, 0)
    tagLbl.Position = UDim2.new(0, 0, 0.5, 0)
    tagLbl.BackgroundTransparency = 1
    tagLbl.Text = "BASE OWNER"
