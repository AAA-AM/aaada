    pad1.PaddingTop = UDim.new(0, 4); pad1.PaddingBottom = UDim.new(0, 0)

    local kickBtn = Instance.new("TextButton", row1)
    kickBtn.Size = UDim2.new(1, -BTN_H - 6, 1, -4)
    kickBtn.BackgroundColor3 = Config.AutoKickEnabled and C_ON or C_OFF
    kickBtn.Text = Config.AutoKickEnabled and "AUTO KICK: ON" or "AUTO KICK: OFF"
    kickBtn.Font = FONT_B; kickBtn.TextSize = 13; kickBtn.TextColor3 = C_TEXT
    kickBtn.AutoButtonColor = false; kickBtn.BorderSizePixel = 0
    mkCorner(kickBtn, 6)

    local gearBtn = Instance.new("TextButton", row1)
    gearBtn.Size = UDim2.fromOffset(BTN_H - 2, BTN_H - 6)
    gearBtn.Position = UDim2.new(1, -BTN_H + 2, 0, 2)
    gearBtn.BackgroundColor3 = C_SURF; gearBtn.AutoButtonColor = false
    gearBtn.Text = "⚙"; gearBtn.Font = FONT_B; gearBtn.TextSize = 16
    gearBtn.TextColor3 = C_DIM; gearBtn.BorderSizePixel = 0
    mkCorner(gearBtn, 6); mkStroke(gearBtn, C_STROKE)

    -- ── Fila 2: [REJOIN] ──────────────────────────────────────────────
    local row2 = Instance.new("Frame", main)
    row2.LayoutOrder = 3; row2.Size = UDim2.new(1, 0, 0, BTN_H)
    row2.BackgroundTransparency = 1; row2.BorderSizePixel = 0
    local pad2 = Instance.new("UIPadding", row2)
    pad2.PaddingLeft = UDim.new(0, 6); pad2.PaddingRight = UDim.new(0, 6)
    pad2.PaddingTop = UDim.new(0, 2); pad2.PaddingBottom = UDim.new(0, 6)

    local rejoinBtn = Instance.new("TextButton", row2)
    rejoinBtn.Size = UDim2.new(1, 0, 1, 0)
    rejoinBtn.BackgroundColor3 = C_OFF; rejoinBtn.AutoButtonColor = false
    rejoinBtn.Text = "REJOIN"; rejoinBtn.Font = FONT_B; rejoinBtn.TextSize = 13
    rejoinBtn.TextColor3 = C_TEXT; rejoinBtn.BorderSizePixel = 0
    mkCorner(rejoinBtn, 6)

    -- ── Overlay "Nigga Why U See That" (abre/cierra con ⚙) ──────────
    local overlaySg = Instance.new("ScreenGui", pg)
    overlaySg.Name = "AutoKickOverlay"; overlaySg.ResetOnSpawn = false
    overlaySg.DisplayOrder = 9999; overlaySg.IgnoreGuiInset = true
    overlaySg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local overlayFrame = Instance.new("Frame", overlaySg)
    overlayFrame.Size = UDim2.new(1, 0, 1, 0); overlayFrame.BackgroundTransparency = 1
    overlayFrame.Visible = false; overlayFrame.BorderSizePixel = 0

    local overlayLbl = Instance.new("TextLabel", overlayFrame)
    overlayLbl.Size = UDim2.new(1, 0, 1, 0)
    overlayLbl.BackgroundTransparency = 1
    overlayLbl.Text = "Nigga Why U See That"
    overlayLbl.Font = Enum.Font.GothamBlack; overlayLbl.TextSize = 42
    overlayLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    overlayLbl.TextStrokeTransparency = 0.4
    overlayLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    overlayLbl.TextXAlignment = Enum.TextXAlignment.Center
    overlayLbl.TextYAlignment = Enum.TextYAlignment.Center
    overlayLbl.TextWrapped = true

    local overlayOpen = false

    -- ── Eventos ───────────────────────────────────────────────────────
    local function refreshKick()
        local on = Config.AutoKickEnabled
        TS2:Create(kickBtn, TweenInfo.new(0.12), {BackgroundColor3 = on and C_ON or C_OFF}):Play()
        kickBtn.Text = on and "AUTO KICK: ON" or "AUTO KICK: OFF"
    end

    kickBtn.MouseButton1Click:Connect(function()
        Config.AutoKickEnabled = not Config.AutoKickEnabled
        if Config.AutoKickEnabled then
            autoKickFired = false
            startAutoKick()
        else
            stopAutoKick()
        end
        SaveConfig()
        refreshKick()
    end)

    gearBtn.MouseEnter:Connect(function() TS2:Create(gearBtn, TweenInfo.new(0.12), {TextColor3 = C_TEXT}):Play() end)
    gearBtn.MouseLeave:Connect(function() TS2:Create(gearBtn, TweenInfo.new(0.12), {TextColor3 = C_DIM}):Play() end)
    gearBtn.MouseButton1Click:Connect(function()
        overlayOpen = not overlayOpen
        overlayFrame.Visible = overlayOpen
    end)

    rejoinBtn.MouseEnter:Connect(function() TS2:Create(rejoinBtn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play() end)
    rejoinBtn.MouseLeave:Connect(function() TS2:Create(rejoinBtn, TweenInfo.new(0.12), {BackgroundColor3 = C_OFF}):Play() end)
    rejoinBtn.MouseButton1Click:Connect(function()
        local link = tostring(Config.PrivateServerLink or ""):match("^%s*(.-)%s*$")
        local code = extractPrivateServerCode(link)
        if code and code ~= "" then
            pcall(function()
                game:GetService("ExperienceService"):LaunchExperience({
                    placeId  = PS_PLACE_ID,
                    linkCode = code,
                })
            end)
        else
            pcall(function()
                game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
            end)
        end
    end)

    -- Sync visual con estado inicial
    refreshKick()
end)
