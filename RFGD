        loadModules()
        local Plots = workspace:FindFirstChild("Plots")
        local all = (_G.SXE_AllCachedChannels and _G.SXE_AllCachedChannels()) or {}
        if not Plots then return pets end
        for _, plot in ipairs(Plots:GetChildren()) do
            local ch = all[plot.Name]
            if not ch then continue end
            if ownerName(ch) == player.Name then continue end
            local al = channelGet(ch, "AnimalList")
            if type(al) ~= "table" then continue end
            for slot, ad in pairs(al) do
                if type(ad) ~= "table" then continue end
                local aName = ad.Index or ad.Name or ad.Animal
                if not aName or isFusing(ad) then continue end
                local info = AnimalsData and AnimalsData[aName]
                local pos = getPetPosition(plot, slot)
                if not pos then
                    local ok, cf = pcall(function() return plot:GetPivot() end)
                    if ok then pos = cf.Position end
                end
                if pos then
                    local _mv = (ad.CashPerSecond or ad.MPS or ad.Gen or ad.Generation or ad.CashGeneration or ad.Value or 0)
                    if type(_mv) ~= "number" then _mv = 0 end
                    if _mv == 0 and info then _mv = info.CashPerSecond or info.MPS or info.BaseGen or info.Generation or info.Value or 0 end
                    table.insert(pets, {
                        name = (info and info.DisplayName) or tostring(aName),
                        index = tostring(aName), mps = _mv, mpsValue = _mv,
                        mutation = ad.Mutation or "None",
                        position = pos, plot = plot.Name, slot = tostring(slot),
