-- ── Walk Speed (CFrame bypass) ───────────────────────────────────────
local _wsState = { enabled = false, conn = nil }
local function _wsSetEnabled(on)
    _wsState.enabled = on
    if _wsState.conn then _wsState.conn:Disconnect(); _wsState.conn = nil end
    if not on then
        -- restore default walkspeed
        local char = LP.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
        return
    end
    _wsState.conn = RS.Heartbeat:Connect(function(dt)
        local char = LP.Character; if not char then return end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        local spd = Config.WalkSpeedValue or 28
        if hum.MoveDirection.Magnitude > 0 and spd > hum.WalkSpeed then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (spd - hum.WalkSpeed) * dt)
        end
    end)
end

-- Auto-enable WalkSpeed on steal if configured
local _wsOrigOnSteal = nil
local function _wsHandleStealState(stealing)
    if not Config.WalkSpeedOnSteal then return end
    if stealing then
        _wsOrigOnSteal = _wsState.enabled
        if not _wsState.enabled then _wsSetEnabled(true) end
    else
        if not _wsOrigOnSteal then _wsSetEnabled(false) end
        _wsOrigOnSteal = nil
    end
end
_G._wsHandleStealState = _wsHandleStealState

