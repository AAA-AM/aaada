    local function _normName2(s)
        return tostring(s):lower():gsub("[%s%-_'%.]","")
    end
    local function _pickByMode(pets)
        if not pets or #pets == 0 then return nil end
        local C = Config or {}
        local mode = C.StealMode or "Priority"

        -- Helper: pick highest MPS
        local function _highestMPS()
            local best, bv
            for _, p in ipairs(pets) do
                local v = p.mps or 0
                if not bv or v > bv then bv, best = v, p end
            end
            return best
        end

        if mode == "Highest" then
            return _highestMPS()
        end

        if mode == "Priority" then
            if priorityList and #priorityList > 0 then
                for _, pName in ipairs(priorityList) do
                    local sn = _normName2(pName)
                    local best, bestMPS = nil, -1
                    for _, p in ipairs(pets) do
                        if _normName2(p.name or "") == sn or _normName2(p.index or "") == sn then
                            local v = p.mps or p.mpsValue or 0
                            if v > bestMPS then bestMPS = v; best = p end
                        end
                    end
                    if best then return best end
                end
            end
            return nil -- no priority pet on server, don't TP
        end

        -- Default (Nearest is handled upstream, this handles any other mode)
        return _highestMPS() or pets[1]
    end
    local function _samePet(a, b)
        if not a or not b then return false end
        return a.plot == b.plot and tostring(a.slot) == tostring(b.slot)
    end
    local function pickStealPet(allPets, hrp, fallbackFirst, allowConveyorManual)
        local pet
        if manuallySelectedUID then
            for _, p in ipairs(allPets) do
                if p.plot and p.slot and (p.plot .. "_" .. tostring(p.slot)) == manuallySelectedUID then
                    if allowConveyorManual or not p.conveyor then pet = p; break end
                end
            end
        end
        if not pet then pet = findPetByUID(allPets, getStealTargetUID()) end
        if pet then return fallbackFirst and (pet or allPets[1]) or pet end
        local mode = (Config and Config.StealMode) or "Priority"
        local nc = {}
        for _, p in ipairs(allPets) do if not p.conveyor then nc[#nc + 1] = p end end

        if mode == "Nearest" and hrp then
            -- Pick nearest pet by prompt distance
            local bd
            for _, p in ipairs(nc) do
                local prompt = findStealPrompt(p)
                if prompt and prompt.Parent then
                    local pp = prompt.Parent
                    local ppPos = (pp:IsA("BasePart") and pp.Position)
                        or (pp.Parent and pp.Parent:IsA("BasePart") and pp.Parent.Position)
                    if ppPos then
                        local d = (hrp.Position - ppPos).Magnitude
                        if not bd or d < bd then bd, pet = d, p end
                    end
                end
            end
            -- fallback if no prompt found: closest by position
            if not pet then
                local bd2
                for _, p in ipairs(nc) do
                    if p.position then
                        local d = (hrp.Position - p.position).Magnitude
                        if not bd2 or d < bd2 then bd2, pet = d, p end
                    end
                end
            end
        else
            pet = _pickByMode(nc)
        end
        return fallbackFirst and (pet or allPets[1]) or pet
    end
