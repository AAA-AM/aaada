-- =====================================================================
-- RESET ESP AL CAMBIAR DE SERVIDOR
-- Cuando el jugador hace teleport/rejoin, los Highlights quedan basura
-- en el PlayerGui del nuevo servidor. Detectamos el teleport y
-- re-inicializamos el ESP limpiamente.
-- =====================================================================
do
    local function _onTeleportInitiated()
        -- Desactivar ESP en el cliente actual antes de salir
        -- (evita que los Highlights del PlayerGui viejo persistan)
        if espPlayerEnabled then
            pcall(disableESPPlayer)
        end
        if espBaseOwnerEnabled then
            pcall(disableESPBaseOwner)
        end
    end

    -- TeleportService.LocalPlayerArrivedFromTeleport se dispara al llegar
    -- al nuevo servidor. Re-aplicamos el ESP según Config.
    local ok1 = pcall(function()
        game:GetService("TeleportService").LocalPlayerArrivedFromTeleport:Connect(function()
            task.wait(2) -- esperar a que el mundo cargue
            -- Limpiar cualquier GUI de ESP que haya sobrevivido
            for _, sg in ipairs(PlayerGui:GetChildren()) do
                if sg.Name:find("SXEEsp") then pcall(function() sg:Destroy() end) end
            end
            espPlayerEnabled = false
            espBaseOwnerEnabled = false
            espBaseOwnerHolder = nil
            espPlayerHighlights = {}
            espPlayerConnections = {}
            -- Re-aplicar según config guardado
            if Config.ESPPlayerEnabled then pcall(enableESPPlayer) end
            if Config.ESPBaseOwnerEnabled then pcall(enableESPBaseOwner) end
        end)
    end)

    -- Fallback: detectar via LocalPlayer.OnTeleport (método más viejo)
    if not ok1 then
        pcall(function()
            game:GetService("TeleportService").OnTeleportInitiated:Connect(_onTeleportInitiated)
        end)
    end

    -- Fallback adicional: detectar cuando el LocalPlayer carga en nuevo lugar
    -- vía Players.LocalPlayer.CharacterAdded después de un teleport de servidor
    local _lastGameId = game.JobId
    RunService.Heartbeat:Connect(function()
        local currentJobId = game.JobId
        if currentJobId ~= "" and currentJobId ~= _lastGameId then
            _lastGameId = currentJobId
            task.spawn(function()
                task.wait(2)
                for _, sg in ipairs(PlayerGui:GetChildren()) do
                    if sg.Name:find("SXEEsp") then pcall(function() sg:Destroy() end) end
                end
                espPlayerEnabled = false
                espBaseOwnerEnabled = false
                espBaseOwnerHolder = nil
                espPlayerHighlights = {}
                espPlayerConnections = {}
                if Config.ESPPlayerEnabled then pcall(enableESPPlayer) end
                if Config.ESPBaseOwnerEnabled then pcall(enableESPBaseOwner) end
            end)
        end
    end)
end

