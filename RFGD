                        if (_h.AssemblyLinearVelocity.Y > 1) or (_dy > 0.01 and _dy < 5) then
                            _plat.CanCollide = false
                        else
                            _plat.CanCollide = (_cy > _plat.Position.Y + 0.1)
                        end
                        _lastY = _cy
                    end
                end)
            end
            task.spawn(function()
                local _s = tick()
                while tick() - _s < 20 do
                    if player:GetAttribute("Stealing") or _G.VanishTPStop then break end
                    task.wait(0.1)
                end
                if _plat and _plat.Parent then _plat:Destroy() end
            end)
        end
        local goal = _to
        local _route
        if h >= 11 and h <= 23.15 then
            local underY = math.min(hrp.Position.Y, 0)
            _route = { Vector3.new(petPos.X, underY, petPos.Z), goal }
        else
            _route = { goal }
        end
        -- comme Vanish: VanishGoSpeed ou 400
        local _goSpd = math.clamp(
            tonumber(_G.VanishGoSpeed)
                or tonumber(Config and Config.TpSettings and Config.TpSettings.WalkTPSpeed)
                or 400,
            200, 600
        )
        vanishVelMoveThrough(hrp, _route, _goSpd)

        -- settle court uniquement si pas encore dessus (pas de crawl lent long)
        do
            local flat = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(goal.X, 0, goal.Z)).Magnitude
            local dy = math.abs(hrp.Position.Y - goal.Y)
            if flat > 2.5 or dy > 3 then
                local t0 = os.clock()
                while os.clock() - t0 < 1.2 do
                    if not hrp or not hrp.Parent then break end
                    if player:GetAttribute("Stealing") then break end
                    equipCarpet()
                    local diff = goal - hrp.Position
                    flat = Vector3.new(diff.X, 0, diff.Z).Magnitude
                    dy = math.abs(diff.Y)
                    if flat <= 2.5 and dy <= 3 then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        break
                    end
                    if diff.Magnitude > 0.1 then
                        pcall(function()
                            hrp.AssemblyLinearVelocity = diff.Unit * _goSpd
                        end)
                    end
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    RunService.Heartbeat:Wait()
                end
            end
        end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
    local InternalStealCache = {}
    local STEAL_HOLD_DURATION = 1.3
    local _stealHoldStart = 0
    local _stealHoldActive = false
    local function buildStealCallbacks(prompt)
        if InternalStealCache[prompt] then return end
        if not prompt or not prompt.Parent then return end
        local data = { holdCallbacks = {}, triggerCallbacks = {}, holdEndCallbacks = {}, ready = true }
        local function grab(sig, into)
            local ok, conns = pcall(getconnections, sig)
            if ok and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    if type(c.Function) == "function" then table.insert(into, c.Function) end
                end
            end
        end
        grab(prompt.PromptButtonHoldBegan, data.holdCallbacks)
        grab(prompt.Triggered, data.triggerCallbacks)
        grab(prompt.PromptButtonHoldEnded, data.holdEndCallbacks)
        if #data.holdCallbacks > 0 or #data.triggerCallbacks > 0 or #data.holdEndCallbacks > 0 then
            InternalStealCache[prompt] = data
        end
    end
    local function executeStealAsync(prompt, restoreMax)
        local data = InternalStealCache[prompt]
        if not data or not data.ready then return false end
        data.ready = false
        _stealHoldStart = tick()
        _stealHoldActive = true
        -- garder la range ouverte pendant tout le hold (sinon 100% client / fail serveur)
        pcall(function() prompt.MaxActivationDistance = math.huge end)
        local hold = STEAL_HOLD_DURATION
        pcall(function()
            local hd = prompt.HoldDuration
            if type(hd) == "number" and hd > 0 then
                hold = math.max(STEAL_HOLD_DURATION, hd + 0.05)
            end
        end)
        _G.SXE_StealStatus = _G.SXE_StealStatus or {}
        _G.SXE_StealStatus.active = true
        _G.SXE_StealStatus.fillStart = _stealHoldStart
        _G.SXE_StealStatus.start = _stealHoldStart
        _G.SXE_StealStatus.duration = hold
        if _stealTarget then _G.SXE_StealStatus.target = _stealTarget end
        task.spawn(function()
            for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
            pcall(function()
                local _st = prompt:GetAttribute("State")
                if _st ~= nil and _st ~= "Steal" then
                    if not _G._xenStealRemote then
                        _G._xenStealRemote = getRemote("RemoteEvent","f40f7d9e-2f0d-4167-b250-899273f46874")
                    end
                    local r = _G._xenStealRemote
                    if r then
                        local _t = workspace:GetServerTimeNow() + 124
                        r:FireServer(_t, "68c86eb7-eb7e-4b4d-96ae-cf7cd847c5b0")
                        r:FireServer(_t, "07b9cc25-2a1f-4a26-a0ec-f2fab578d8bd")
                    end
                end
            end)
            local remain = hold - (tick() - _stealHoldStart)
            if remain > 0 then task.wait(remain) end
            if prompt and prompt.Parent then
                for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
            end
            for _, fn in ipairs(data.holdEndCallbacks) do task.spawn(fn) end
            _stealHoldActive = false
            if _G.SXE_StealStatus then _G.SXE_StealStatus.active = false end
            if restoreMax ~= nil then
                pcall(function() if prompt and prompt.Parent then prompt.MaxActivationDistance = restoreMax end end)
            end
            task.wait(0.05)
            data.ready = true
        end)
        return true
    end
    local _promptCache = {}
    local function findStealPrompt(pet)
        local ck = tostring(pet.plot) .. ":" .. tostring(pet.slot)
        local cached = _promptCache[ck]
        if cached and cached.Parent then return cached end
        if pet.plot and pet.slot then
            local plots = workspace:FindFirstChild("Plots")
            local plot = plots and plots:FindFirstChild(pet.plot)
            local podiums = plot and plot:FindFirstChild("AnimalPodiums")
            local podium = podiums and podiums:FindFirstChild(tostring(pet.slot))
            if podium then
                local base = podium:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                local attach = spawn and spawn:FindFirstChild("PromptAttachment")
                if attach then
                    for _, p in ipairs(attach:GetChildren()) do
                        if p:IsA("ProximityPrompt") then _promptCache[ck] = p; return p end
                    end
                end
                for _, d in ipairs(podium:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then _promptCache[ck] = d; return d end
                end
            end
        end
        if pet.model and pet.model.Parent then
            for _, d in ipairs(pet.model:GetDescendants()) do
                if d:IsA("ProximityPrompt") then return d end
            end
        end
        return nil
    end
