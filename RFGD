            elseif _slot >= 11 then _itemFloor = 2
            elseif _slot >= 1 then _itemFloor = 1 end
        end
        local _startY = hrp.Position.Y
        local _myFloor = 0
        if _startY >= -6.9 and _startY <= 8.9 then _myFloor = 1
        elseif _startY >= 11 and _startY <= 23.15 then _myFloor = 2
        elseif _startY > 23.15 then _myFloor = 3 end
