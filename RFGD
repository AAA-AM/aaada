local autoBuyActive = false
local abLockedTarget, abLockedPart, abLockedModel = nil, nil, nil
local abBodyPos, abCarpetLockConn, abPurchaseRemote = nil, nil, nil
local AB_HOVER_HEIGHT = 5
local fireproximityprompt = fireproximityprompt or (getfenv and getfenv().fireproximityprompt) or nil

local function abResolvePurchaseRemote()
    if abPurchaseRemote and abPurchaseRemote.Parent then return abPurchaseRemote end
    pcall(function()
        local net = ReplicatedStorage:FindFirstChild("Packages")
                 and ReplicatedStorage.Packages:FindFirstChild("Net")
        if not net then return end
        for _, v in ipairs(net:GetChildren()) do
            local nl = (v.Name or ""):lower()
            for _, kw in ipairs({"buy","purchase","animal","shop","acquire","conveyor"}) do
                if nl:find(kw) then abPurchaseRemote = v; return end
            end
        end
    end)
    return abPurchaseRemote
end
task.defer(abResolvePurchaseRemote)

local function abFirePurchase(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return end
    pcall(function() prompt.HoldDuration = 0 end)
    pcall(function() if fireproximityprompt then fireproximityprompt(prompt) end end)
    local remote = abResolvePurchaseRemote()
    if remote then
        pcall(function()
            if remote:IsA("RemoteFunction") then remote:InvokeServer(prompt.Parent)
            elseif remote:IsA("RemoteEvent") then remote:FireServer(prompt.Parent) end
        end)
    end
end

local function abPartAlive()
    return abLockedPart and abLockedPart.Parent and abLockedModel and abLockedModel.Parent
end
local function abPromptAlive()
    return abLockedTarget and abLockedTarget.prompt
        and abLockedTarget.prompt.Parent and abLockedTarget.prompt.Enabled
end

local function abEnsureBodyPos(hrp)
    if abBodyPos and abBodyPos.Parent == hrp then return abBodyPos end
    if abBodyPos then abBodyPos:Destroy() end
    local bp = Instance.new("BodyPosition", hrp)
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P = 20000; bp.D = 1000; bp.Position = hrp.Position
    abBodyPos = bp; return bp
end
local function abDestroyBodyPos()
    if abBodyPos then abBodyPos:Destroy(); abBodyPos = nil end
end

local function abEnsureCarpet()
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local tn = "Flying Carpet"
        if not char:FindFirstChild(tn) then
            local tool = LocalPlayer.Backpack:FindFirstChild(tn)
            if tool then hum:EquipTool(tool) end
        end
    end)
end

local function abStartCarpetLock()
    if abCarpetLockConn then abCarpetLockConn:Disconnect(); abCarpetLockConn = nil end
    task.spawn(function()
        for _ = 1, 15 do
            if not autoBuyActive then break end
            abEnsureCarpet(); task.wait(0.3)
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Flying Carpet") then break end
        end
    end)
    local _cl = 0
    abCarpetLockConn = RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now - _cl < 0.5 then return end; _cl = now
        if autoBuyActive then abEnsureCarpet() end
    end)
end
local function abStopCarpetLock()
    if abCarpetLockConn then abCarpetLockConn:Disconnect(); abCarpetLockConn = nil end
end

-- Hover loop
RunService.Heartbeat:Connect(function()
