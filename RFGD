            _plat.Name = "XenHubTempPlatform"
            _plat.Size = Vector3.new(8, 1, 8)
            _plat.Position = Vector3.new(petPos.X, _to.Y - 4.5, petPos.Z)
            _plat.Anchored = true
            _plat.CanCollide = (not _approachBelow)
            _plat.Transparency = 1
            _plat.Material = Enum.Material.SmoothPlastic
            _plat.Parent = workspace
            if _approachBelow then
                local _lastY
                local _owConn
                _owConn = RunService.Stepped:Connect(function()
                    if not _plat or not _plat.Parent then
