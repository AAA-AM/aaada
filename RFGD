                end
            end
        end

        if _cloneOk and _insidePlot then
            _G._curStealSlot = tonumber(pet and pet.slot) or _G._curStealSlot
            -- snap instant + hold; floor3 = pin depuis le 2e (Y21) jusqu'a fin du steal
            local _SNAP_HOLD = 1.15
            do
                local h = petPos.Y
                local function _isCarrying()
                    local st = _G.SXE_StealStatus
                    return (st and (st.carrying or st.hasPet)) or player:GetAttribute("HasBrainrot") == true
