local PCOLS = { C.ACCENT, C.ACCENT2, Color3.fromRGB(180,70,255) }
local particles = {}
for i = 1, 55 do
    local sz  = math.random(2,9)
    local dot = Instance.new("Frame", pBg)
    dot.Size                    = UDim2.new(0,sz,0,sz)
    dot.Position                = UDim2.new(math.random(),0, math.random(),0)
    dot.BackgroundColor3        = PCOLS[math.random(#PCOLS)]
    dot.BackgroundTransparency  = 0.45 + math.random()*0.5
    dot.BorderSizePixel         = 0
    corner(dot, 999)
    particles[i] = {
        f  = dot,
        vx = (math.random()-0.5)*0.006,
        vy = (math.random()-0.5)*0.005,
        td = math.random() > 0.5 and 1 or -1,
        ts = 0.001 + math.random()*0.0015,
    }
end
task.spawn(function()
    while sg and sg.Parent do
        for _, p in ipairs(particles) do
            local f = p.f
            local x = f.Position.X.Scale + p.vx
            local y = f.Position.Y.Scale + p.vy
            if x<0 then x=1 elseif x>1 then x=0 end
            if y<0 then y=1 elseif y>1 then y=0 end
            f.Position = UDim2.new(x,0,y,0)
            local nt = f.BackgroundTransparency + p.ts*p.td
            if nt>0.9 then nt=0.9; p.td=-1 elseif nt<0.3 then nt=0.3; p.td=1 end
            f.BackgroundTransparency = nt
        end
        task.wait(0.04)
    end
