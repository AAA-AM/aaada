local function applySearch(cont, txt)
    local low = txt and txt ~= "" and txt:lower() or nil
    for _, ch in pairs(cont:GetChildren()) do
        if ch:IsA("Frame") and ch.Name ~= "__empty" then
            ch.Visible = not low or (ch.Name:lower():find(low,1,true) ~= nil)
        end
    end
end

