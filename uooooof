    statLbl.TextColor3 = col or C.TSUB
    tw(statDot, { BackgroundColor3=dotC or C.SUCCESS })
end

-- ══════════════════ CARD ══════════════════

local function createCard(parent, cfg)
    local CARD_H = 96

    local card = Instance.new("Frame", parent)
    card.Name             = cfg.animalName or "card"
    card.Size             = UDim2.new(1,0,0,CARD_H)
    card.BackgroundColor3 = C.CARD
    card.LayoutOrder      = cfg.order or 0
    card.ZIndex           = 9
    corner(card, 12)
    stroke(card, C.BORDER, 1)

    card.MouseEnter:Connect(function() tw(card,{BackgroundColor3=C.CARD_H}) end)
    card.MouseLeave:Connect(function() tw(card,{BackgroundColor3=C.CARD}) end)

    -- left stripe
    local stripe = Instance.new("Frame", card)
    stripe.Size             = UDim2.new(0,3,0.65,0)
    stripe.Position         = UDim2.new(0,0,0.175,0)
    stripe.BackgroundColor3 = cfg.isMine and C.SUCCESS or C.ACCENT
    stripe.BorderSizePixel  = 0
    stripe.ZIndex           = 10
    corner(stripe, 3)

    -- viewport
    local vp = Instance.new("ViewportFrame", card)
    vp.Size             = UDim2.new(0,78,0,78)
    vp.Position         = UDim2.new(0,12,0.5,-39)
    vp.BackgroundColor3 = Color3.fromRGB(5,5,14)
    vp.ZIndex           = 10
    corner(vp, 9)
    stroke(vp, C.BORDER, 1)

    task.spawn(function()
        local wm  = Instance.new("WorldModel", vp)
        local cam = Instance.new("Camera", vp)
        vp.CurrentCamera = cam

        local source = nil
        for _, plot in pairs(Plots:GetChildren()) do
            for _, obj in pairs(plot:GetDescendants()) do
                if obj:IsA("Model") and obj.Name == cfg.animalName then
                    source = obj; break
                end
            end
            if source then break end
        end

        if source then
            local clone = source:Clone()
            clone.Parent = wm
            local root = clone:FindFirstChild("RootPart") or clone.PrimaryPart
                          or clone:FindFirstChildWhichIsA("BasePart",true)
            if root then
                cam.CFrame = CFrame.new(root.Position + Vector3.new(0,3,8), root.Position)
                local a  = findAnimator(clone)
                local sa = findAnimator(source)
                if a and sa then
                    pcall(function()
                        for _, t in pairs(sa:GetPlayingAnimationTracks()) do
                            local nt = a:LoadAnimation(t.Animation)
                            nt.Looped=true; nt:Play()
                            nt.TimePosition = t.TimePosition
                        end
                    end)
                end
            end
        else
            local p = Instance.new("Part", wm)
            p.Size     = Vector3.new(3,3,3)
            p.BrickColor = BrickColor.new("Bright violet")
            p.Material   = Enum.Material.Neon
            cam.CFrame = CFrame.new(Vector3.new(0,2,9), Vector3.new(0,1.5,0))
        end
    end)

    -- name
    mkLabel(card, {
        Size      = UDim2.new(0.55,0,0,20),
        Position  = UDim2.new(0,100,0,10),
        Text      = (cfg.animalName or "?"):upper(),
        Font      = Enum.Font.GothamBlack,
        TextSize  = math.floor(14*scale),
        TextColor3 = C.TEXT,
        ZIndex    = 10,
    })

    -- owner badge
    if cfg.ownerName then
        local badge = Instance.new("Frame", card)
        badge.Size              = UDim2.new(0,0,0,20)
        badge.Position          = UDim2.new(0,100,0,34)
        badge.BackgroundColor3  = cfg.isMine and Color3.fromRGB(15,40,25) or Color3.fromRGB(15,15,35)
        badge.AutomaticSize     = Enum.AutomaticSize.X
        badge.ZIndex            = 10
        corner(badge, 6)

        local badgeL = mkLabel(badge, {
            Size          = UDim2.new(0,0,1,0),
            AutomaticSize = Enum.AutomaticSize.X,
            Text          = cfg.isMine and ("⭐ YOU — "..cfg.ownerName) or ("👤 "..cfg.ownerName),
            Font          = Enum.Font.GothamSemibold,
            TextSize      = 10,
            TextColor3    = cfg.isMine and C.SUCCESS or C.TSUB,
            ZIndex        = 11,
        })
        local badgePad = Instance.new("UIPadding", badge)
        badgePad.PaddingLeft  = UDim.new(0,6)
        badgePad.PaddingRight = UDim.new(0,6)
    end

    -- action button
    local function mkActionBtn(x, xOff, w, text, bg)
        local b = mkButton(card, {
            Size             = UDim2.new(0,w,0,28),
            Position         = UDim2.new(x, xOff, 1,-38),
            BackgroundColor3 = bg,
            Text             = text,
            TextColor3       = Color3.new(1,1,1),
            Font             = Enum.Font.GothamBold,
            TextSize         = 11,
            ZIndex           = 10,
        })
        corner(b, 8)
        b.MouseEnter:Connect(function() tw(b,{BackgroundColor3=bg:lerp(Color3.new(1,1,1),0.15)}) end)
        b.MouseLeave:Connect(function() tw(b,{BackgroundColor3=bg}) end)
        return b
    end

    local actionBtn
    if cfg.isMine then
        actionBtn = mkActionBtn(0,100,96, "✦ ACTIVE", Color3.fromRGB(18,45,28))
        actionBtn.TextColor3 = C.SUCCESS
        actionBtn.Active     = false
    else
        local bg = (cfg.btnLabel == "💎 OFFER") and C.ACCENT or Color3.fromRGB(28,28,52)
        actionBtn = mkActionBtn(0,100,110, cfg.btnLabel or "🌍 LIST", bg)
        if cfg.onAction then
            actionBtn.MouseButton1Click:Connect(function()
                cfg.onAction(actionBtn)
            end)
        end
    end

    -- remove button
    if cfg.onRemove then
        local remBtn = mkActionBtn(1,-118, 106, "🗑 REMOVE", Color3.fromRGB(48,15,15))
        remBtn.TextColor3 = C.DANGER
        remBtn.MouseButton1Click:Connect(function()
            tw(card, {BackgroundTransparency=1, Size=UDim2.new(1,0,0,0)}, 0.22)
            task.wait(0.25)
            card:Destroy()
            if cfg.onRemove then cfg.onRemove() end
        end)
    end

    return card
end

-- ══════════════════ REFRESH FUNCTIONS ══════════════════

local function refreshGlobal()
    clearContainer(containers["GLOBAL"])
    setStatus("Fetching global listings...", C.ACCENT2, C.ACCENT2)
    task.spawn(function()
        local listings = fetchListings()
        clearContainer(containers["GLOBAL"])
        local count = 0
        for _, data in pairs(listings) do
            count = count + 1
            local isMine = (data.User == LP.Name)
            createCard(containers["GLOBAL"], {
                animalName = data.AnimalName,
                ownerName  = data.User,
                isMine     = isMine,
                btnLabel   = "💎 OFFER",
                order      = count,
                onAction   = isMine and nil or function(btn)
                    tw(btn, {BackgroundColor3=C.SUCCESS})
                    btn.Text   = "OFFERED ✓"
                    btn.Active = false
                    toast("Offer sent on " .. data.AnimalName, "💎", C.ACCENT2)
                    -- log to offers tab
                    createCard(containers["OFFERS"], {
                        animalName = data.AnimalName,
                        ownerName  = data.User,
                        btnLabel   = "OFFERED ✓",
                        order      = os.time(),
                    })
                end,
            })
        end
        if count == 0 then emptyState(containers["GLOBAL"], "No global listings yet.") end
        applySearch(containers["GLOBAL"], searchBox.Text)
        setStatus("Global: "..count.." listing(s) live", C.TSUB, C.SUCCESS)
    end)
end

-- session-local cache: survives tab switches, cleared only on explicit remove
local myAdsCache = {} -- [animalName] = { AnimalName, User, Timestamp }

local function buildMyAdsFromCache()
    clearContainer(containers["MY ADS"])
    local count = 0
    for animalName, data in pairs(myAdsCache) do
        count = count + 1
        createCard(containers["MY ADS"], {
            animalName = animalName,
            ownerName  = LP.Name,
            isMine     = true,
            order      = data.Timestamp or count,
            onRemove   = function()
                myAdsCache[animalName] = nil
                task.spawn(function()
                    removeListing(animalName, LP.Name)
                    toast("Listing removed", "🗑", C.DANGER)
                    task.wait(1.5)
                    refreshGlobal()
                end)
                -- rebuild from updated cache
                buildMyAdsFromCache()
            end,
        })
    end
    if count == 0 then
        emptyState(containers["MY ADS"], "You have no active listings.")
    end
    applySearch(containers["MY ADS"], searchBox.Text)
end

-- also sync cache from server (called when tab opened, merges in any server-side listings)
local function refreshMyAds()
    -- immediately render cache so tab never appears empty
    buildMyAdsFromCache()
    -- then fetch server in background and merge in anything we may have missed
    task.spawn(function()
        local listings = fetchListings()
        local changed = false
        for _, data in pairs(listings) do
            if data.User == LP.Name and not myAdsCache[data.AnimalName] then
                myAdsCache[data.AnimalName] = data
                changed = true
            end
        end
        if changed then buildMyAdsFromCache() end
    end)
end

-- ══════════════════ TAB SWITCHING ══════════════════

local function showTab(name)
    for n, c in pairs(containers) do c.Visible = (n == name) end
    setActiveTab(name)
    if name == "GLOBAL"  then refreshGlobal()  end
    if name == "MY ADS"  then refreshMyAds()   end
    applySearch(containers[name], searchBox.Text)
end

for name, btn in pairs(tabBtns) do
    btn.MouseButton1Click:Connect(function() showTab(name) end)
end

-- ══════════════════ SCAN ══════════════════

local function doScan(cont)
    clearContainer(cont)
    local found = 0
    for _, plot in pairs(Plots:GetChildren()) do
        for _, obj in pairs(plot:GetDescendants()) do
            if obj:IsA("Model") and findAnimator(obj) and obj.Name ~= "Baseplate" then
                found = found + 1
                local captured = obj
                createCard(cont, {
                    animalName = captured.Name,
                    btnLabel   = "🌍 LIST",
                    order      = found,
                    onAction   = function(btn)
                        tw(btn, {BackgroundColor3=C.WARN})
                        btn.Text   = "LISTING..."
                        btn.Active = false
                        task.spawn(function()
                            local data = { User=LP.Name, AnimalName=captured.Name, Timestamp=os.time() }
                            addListing(data)

                            -- write to session cache immediately — survives all tab switches
                            myAdsCache[captured.Name] = data

                            tw(btn, {BackgroundColor3=C.SUCCESS})
                            btn.Text = "LISTED ✓"
                            toast(captured.Name .. " listed globally!", "🌍", C.SUCCESS)

                            -- wait before reading back so rentry has time to process write
                            task.wait(1.5)
                            refreshGlobal()
                        end)
                    end,
                })
            end
        end
    end
    return found
end

scanBtn.MouseButton1Click:Connect(function()
    scanBtn.Text   = "⏳  SCANNING..."
    scanBtn.Active = false
    setStatus("Scanning workspace plots...", C.WARN, C.WARN)
    task.spawn(function()
        local found = doScan(containers["SCAN"])
        scanBtn.Text   = "⚡  SCAN PLOTS"
        scanBtn.Active = true
        applySearch(containers["SCAN"], searchBox.Text)
        if found == 0 then
            emptyState(containers["SCAN"], "No animals found in plots.")
            setStatus("Scan complete — nothing found", C.DANGER, C.DANGER)
        else
            setStatus("Scan complete — "..found.." animal(s) found", C.SUCCESS, C.SUCCESS)
            toast("Found "..found.." animal(s)", "🔍", C.ACCENT2)
        end
    end)
end)

-- ══════════════════ DRAG ══════════════════

local dragging, dStart, wStart
header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true; dStart = i.Position; wStart = win.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dStart
        win.Position = UDim2.new(wStart.X.Scale, wStart.X.Offset+d.X, wStart.Y.Scale, wStart.Y.Offset+d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

