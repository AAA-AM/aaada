-- SETUP: go to https://jsonblob.com, paste {} into the box, hit Save,
-- then copy the NUMBER from the URL (e.g. jsonblob.com/1099940584201240576)
-- and paste it below as a string.

local BLOB_ID  = "019de4e0-822e-702f-8467-8e4ec635f8a2"
local BLOB_URL = "https://jsonblob.com/api/jsonBlob/" .. BLOB_ID

-- debug log goes to F9 console AND the in-game status bar (set later)
local dbgStatus = nil  -- assigned after GUI builds
local function dbg(msg, isErr)
    local prefix = isErr and "[CartiDuel ✗] " or "[CartiDuel] "
    print(prefix .. msg)
    if dbgStatus then
        dbgStatus.Text      = msg
        dbgStatus.TextColor3 = isErr and Color3.fromRGB(255,80,80) or Color3.fromRGB(65,195,255)
    end
end

local function httpReq(url, method, body)
    -- find whichever HTTP function the executor exposes
    local fn = (syn and syn.request)
            or (http_request and http_request)
            or (request and request)
            or (http and http.request)

    if not fn then
        dbg("NO HTTP FUNCTION — enable HTTP in executor settings!", true)
        return nil, "no_http"
    end

    local opts = {
        Url     = url,
        Method  = method or "GET",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Accept"]       = "application/json",
        },
    }
    if body then
        local ok, encoded = pcall(HttpService.JSONEncode, HttpService, body)
        if not ok then dbg("JSON encode failed: " .. tostring(encoded), true); return nil, "encode" end
        opts.Body = encoded
    end

    local ok, res = pcall(fn, opts)
    if not ok then
        dbg("HTTP pcall error: " .. tostring(res), true)
        return nil, "pcall"
    end
    if not res then
        dbg("HTTP returned nil response", true)
        return nil, "nil_res"
    end

    local code = res.StatusCode or res.StatusMessage or "?"
    dbg(method .. " " .. url .. "  →  " .. tostring(code))

    if res.Body and #res.Body > 0 then
        return res.Body, code
    end
    return nil, code
end

local function fetchListings()
    if BLOB_ID == "YOUR_BLOB_ID_HERE" then
        dbg("BLOB_ID not set — open the script and fill in your jsonblob ID!", true)
        return {}
    end
    local raw, code = httpReq(BLOB_URL, "GET")
    if not raw then
        dbg("Fetch failed (code=" .. tostring(code) .. ")", true)
        return {}
    end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok or type(data) ~= "table" then
        dbg("JSON decode failed — raw: " .. tostring(raw):sub(1,80), true)
        return {}
    end
    dbg("Fetched " .. tostring(#(function(t) local n=0; for _ in pairs(t) do n=n+1 end; return n end)(data)) .. " listing(s)")
    return data
end

local function pushListings(t)
    if BLOB_ID == "YOUR_BLOB_ID_HERE" then return end
    local _, code = httpReq(BLOB_URL, "PUT", t)
    if tostring(code):sub(1,1) == "2" then
        dbg("Push OK (code=" .. tostring(code) .. ")")
    else
        dbg("Push may have failed (code=" .. tostring(code) .. ")", true)
    end
end

local function addListing(data)
    dbg("Adding listing: " .. data.AnimalName)
    local all = fetchListings()
    all[data.AnimalName .. "_" .. data.User] = data
    pushListings(all)
end

local function removeListing(animal, user)
    dbg("Removing listing: " .. animal)
    local all = fetchListings()
    all[animal .. "_" .. user] = nil
    pushListings(all)
end

-- ══════════════════ HELPERS ══════════════════

local function findAnimator(m)
    return m:FindFirstChildWhichIsA("Animator", true)
end

local function tw(obj, props, t, style, dir)
    TweenService:Create(obj, TweenInfo.new(
        t or 0.2,
        style or Enum.EasingStyle.Quart,
        dir   or Enum.EasingDirection.Out
    ), props):Play()
end

local function corner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 10)
    return c
end

local function stroke(p, col, thick)
    local s = Instance.new("UIStroke", p)
    s.Color     = col or Color3.fromRGB(40,40,65)
    s.Thickness = thick or 1
    return s
end

local function mkLabel(parent, props)
    local l = Instance.new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.TextXAlignment = Enum.TextXAlignment.Left
    for k, v in pairs(props) do l[k] = v end
    return l
end

local function mkButton(parent, props)
    local b = Instance.new("TextButton", parent)
    b.BorderSizePixel  = 0
    b.AutoButtonColor  = false
    for k, v in pairs(props) do b[k] = v end
    return b
end

